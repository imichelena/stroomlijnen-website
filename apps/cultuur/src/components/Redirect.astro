---
interface Props {lang: 'nl' | 'en'; to: string; label: string}
const {lang, to, label} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>{label} | Stroomlijnen Cultuur</title>
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <script define:vars={{to}}>location.replace(to + location.search + location.hash);</script>
    <meta http-equiv="refresh" content={'0;url=' + to} />
  </head>
  <body><a href={to}>{label}</a></body>
</html>
