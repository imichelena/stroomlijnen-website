---
import '../styles/global.css';
import {pages, sectorOrigin, gatewayOrigin, sharedFormPage, type Locale} from '../lib/routes';

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  activeNav?: string;
  bodyClass?: string;
}

const {title, lang = 'nl', bodyClass = ''} = Astro.props;
const en = lang === 'en';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') + '/';
const page = pages.find(entry => entry[lang] === currentPath);
if (!page) throw new Error('Missing Cultuur language pair for ' + currentPath);
const description = Astro.props.description ?? (en
  ? 'Charging at theatres and venues for electric touring vehicles. Explore Stroomlijnen’s solutions for venues and touring companies.'
  : 'Laden bij theaters en podia voor elektrisch vervoer op tournee. Bekijk de oplossingen van Stroomlijnen voor podia en reizende gezelschappen.');
const canonical = sectorOrigin + page[lang];
const menuLabel = en ? 'Open menu' : 'Menu openen';
const closeLabel = en ? 'Close menu' : 'Menu sluiten';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Stroomlijnen Cultuur</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="nl" href={sectorOrigin + page.nl} />
    <link rel="alternate" hreflang="en" href={sectorOrigin + page.en} />
    <link rel="alternate" hreflang="x-default" href={sectorOrigin + page.nl} />
    <meta property="og:title" content={title + ' | Stroomlijnen Cultuur'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={en ? 'en_GB' : 'nl_NL'} />
    <meta property="og:image" content={sectorOrigin + '/images/hero-carre-1100.jpg'} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">{en ? 'Skip to content' : 'Naar de inhoud'}</a>
    <header class="site-header">
      <div class="container nav-inner">
        <a href={pages[0][lang]} class="nav-logo" aria-label={en ? 'Stroomlijnen Cultuur homepage' : 'Stroomlijnen Cultuur startpagina'}>
          <img src="/stroomlijnen-logo-transparent-OFFICIAL.png" alt="Stroomlijnen" width="216" height="36" /><span>Cultuur</span>
        </a>
        <nav class="primary-nav" aria-label={en ? 'Main navigation' : 'Hoofdnavigatie'}>
          <button class="nav-toggle" id="navToggle" type="button" aria-label={menuLabel}
            data-open-label={menuLabel} data-close-label={closeLabel} aria-expanded="false" aria-controls="navLinks">
            <span></span><span></span><span></span>
          </button>
          <ul class="nav-links" id="navLinks" role="list">
            {pages.map(item => <li><a href={item[lang]} aria-current={item === page ? 'page' : undefined}>{item.label[lang]}</a></li>)}
            <li><a href={sharedFormPage(lang)}><span class="nav-cta">Contact</span></a></li>
          </ul>
        </nav>
        <nav class="language-links" aria-label={en ? 'Language' : 'Taal'}>
          <a href={page.nl} hreflang="nl" lang="nl" aria-label="Nederlands" aria-current={!en ? 'page' : undefined}>NL</a>
          <span aria-hidden="true">/</span>
          <a href={page.en} hreflang="en" lang="en" aria-label="English" aria-current={en ? 'page' : undefined}>EN</a>
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <img src="/stroomlijnen-logo-transparent-OFFICIAL.png" alt="Stroomlijnen" width="168" height="28" />
        </div>
        <nav class="footer-links" aria-label={en ? 'Footer navigation' : 'Footernavigatie'}>
          {pages.map(item => <a href={item[lang]}>{item.label[lang]}</a>)}
          <a href={sharedFormPage(lang)}>Contact</a>
          <a href={gatewayOrigin + (en ? '/en/' : '/')}>{en ? 'All sectors' : 'Alle sectoren'}</a>
          <a href={'https://docs.stroomlijnen.nl' + (en ? '/en/' : '/')}>{en ? 'Technical documentation' : 'Technische documentatie'}</a>
        </nav>
        <div class="footer-contact"><a href="mailto:info@stroomlijnen.nl">info@stroomlijnen.nl</a><span>Amsterdam</span></div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Stroomlijnen B.V. {en ? 'All rights reserved.' : 'Alle rechten voorbehouden.'}</p>
          <p class="footer-disclaimer">{en
            ? 'Subsidy amounts and ERE proceeds are indicative. They depend on eligibility, registration and current market rates.'
            : 'Subsidiebedragen en ERE-opbrengsten zijn indicatief en afhankelijk van de voorwaarden, registratie en actuele markttarieven.'}</p>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navLinks');
      if (toggle && links) {
        function setMenu(open: boolean) {
          if (!toggle || !links) return;
          links.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) || '');
        }
        toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setMenu(false);
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>
