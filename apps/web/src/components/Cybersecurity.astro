---
import Layout from '../layouts/StoryLayout.astro';
import { docsUrl, type Lang } from '../data/commercial';
interface Props { lang: Lang }
const { lang } = Astro.props;
const story = {
  en: {
    title: 'The first delivery', emphasis: 'starts the night before.',
    intro: 'When a driver arrives for the early shift, the van needs to be ready. A missed charge can delay a whole route. As more journeys depend on electricity, charging becomes critical infrastructure. Protecting it is part of keeping people and goods moving.',
    image: 'A delivery truck connected to a charger outside a depot.',
    connection: 'Who can reach your chargers?',
    public: 'Some chargers exchange instructions with a service on the public internet. Sometimes those messages travel without encryption. Someone along that route could read a charging record or change an instruction meant for the charger.',
    private: 'At a Stroomlijnen site, the chargers sit on a separate, private network. The operator can still manage charging, but the chargers themselves have no direct path to the public internet. Only the connections needed to run the site are allowed.',
    directTitle: 'Direct internet connection', isolatedTitle: 'Stroomlijnen private site network',
    charger: 'Charger', internet: 'Internet service', controller: 'Site controller', operator: 'Operator',
    outage: 'When a connection drops',
    continuity: 'Imagine a van is plugged in when the connection goes down. Our fast charger keeps a local record of the session. When communication returns, the operator can see what happened. Whether another driver can start charging offline depends on the access arrangements for that site.',
    detail: 'Technical documentation for your IT team'
  },
  nl: {
    title: 'De eerste bezorging', emphasis: 'begint de avond ervoor.',
    intro: 'Als de chauffeur ’s ochtends instapt, moet de bestelbus klaar zijn voor vertrek. Eén gemiste laadbeurt kan een hele route vertragen. Nu steeds meer vervoer elektrisch wordt, is laden cruciaal voor onze mobiliteit. Door het laadnetwerk te beveiligen, helpen we mensen en goederen op weg.',
    image: 'Een vrachtwagen aan de lader bij een distributiegebouw.',
    connection: 'Wie kan er bij uw laders?',
    public: 'Sommige laders wisselen opdrachten uit met een dienst op het openbare internet. Soms gebeurt dat zonder versleuteling. Iemand die op die verbinding kan meelezen, zou dan ook laadgegevens kunnen inzien of een opdracht aan de lader kunnen wijzigen.',
    private: 'Op een Stroomlijnen-locatie staan de laders op een apart, besloten netwerk. De beheerder kan het laden op afstand regelen, terwijl de laders zelf geen rechtstreekse verbinding met het openbare internet hebben. We laten alleen de verbindingen toe die de locatie nodig heeft.',
    directTitle: 'Rechtstreekse internetverbinding', isolatedTitle: 'Besloten netwerk van Stroomlijnen',
    charger: 'Lader', internet: 'Internetdienst', controller: 'Locatiecontroller', operator: 'Beheerder',
    outage: 'Als de verbinding wegvalt',
    continuity: 'Stel dat de verbinding wegvalt terwijl een bestelbus aan de lader staat. Onze snellader bewaart de sessiegegevens ter plaatse. Na herstel kan de beheerder terugzien wat er is gebeurd. Of een volgende chauffeur ook offline kan laden, hangt af van de toegangsafspraken op die locatie.',
    detail: 'Technische documentatie voor uw IT-team'
  }
}[lang];
const diagrams = [
  { title: story.directTitle, nodes: [['charger', story.charger], ['internet', story.internet]] },
  { title: story.isolatedTitle, nodes: [['charger', story.charger], ['controller', story.controller], ['operator', story.operator]] }
];
const icons: Record<string, string> = {
  charger: 'M4 21h12 M6 21V4h8v17 M8 7h4v4H8z M14 10h1a2 2 0 0 1 2 2v3a2 2 0 0 0 4 0V8l-3-3 M18 5v3h3',
  internet: 'M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0z M2 12h20 M12 2c-5 4-5 16 0 20 5-4 5-16 0-20z',
  controller: 'M3 6h18v12H3z M6 3v3m4-3v3m4-3v3m4-3v3 M6 18v3m4-3v3m4-3v3m4-3v3 M6 10h5 M6 13h2m6-2h4v3h-4z',
  operator: 'M2 4h20v13H2z M12 17v4m-5 0h10 M5 12l3-2 3 2 4-5 4 1'
};
---
<Layout {lang} page="security" title="Cybersecurity" description={story.intro}>
  <header class="wrap security-hero">
    <div>
      <p class="eyebrow"><span></span>Cybersecurity</p>
      <h1>{story.title} <em>{story.emphasis}</em></h1>
      <p class="intro">{story.intro}</p>
    </div>
    <img src="/images/scenes/logistics-960.webp"
      srcset="/images/scenes/logistics-640.webp 640w, /images/scenes/logistics-960.webp 960w, /images/scenes/logistics-1536.webp 1536w"
      sizes="(max-width:800px) 100vw, 48vw" width="960" height="640" alt={story.image}/>
  </header>
  <section class="private-network" aria-labelledby="isolation">
    <div class="wrap chapter">
      <h2 id="isolation">{story.connection}</h2>
      <div><p>{story.public}</p><p>{story.private}</p></div>
      <div class="network-diagrams">
        {diagrams.map(({title, nodes}) => (
          <figure class="network-path">
            <figcaption>{title}</figcaption>
            <ol role="list">
              {nodes.map(([icon, label]) => (
                <li>
                  <span class="device">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"><path d={icons[icon]} /></svg>
                  </span>
                  <span>{label}</span>
                </li>
              ))}
            </ol>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <section class="wrap chapter" aria-labelledby="continuity">
    <h2 id="continuity">{story.outage}</h2>
    <div><p>{story.continuity}</p>
      <a class="text-link" href={docsUrl(lang,'security/architecture')}>{story.detail} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
<style>
  .security-hero,.chapter {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(2rem,6vw,6rem);padding-block:clamp(3rem,7vw,6rem)}
  .security-hero {align-items:center}
  .security-hero h1 {font-size:clamp(3rem,5.8vw,6rem);margin:.8rem 0 1.25rem}
  .security-hero em {color:#637c51}
  .security-hero img {width:100%;height:auto}
  .intro,.chapter p {color:#405651;max-width:60ch}
  .private-network {background:#e9edde}
  .chapter h2 {font-size:clamp(2.2rem,4.3vw,4.3rem);max-width:15ch}
  .chapter p+p {margin-top:1rem}
  .chapter .text-link {margin-top:1.5rem}
  .network-diagrams {grid-column:1/-1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .network-path {margin:0;padding:clamp(1rem,2.7vw,2rem);background:#f8f8f1;border:1px solid #bfcbb6;color:#213f38}
  .network-path:last-child {background:#193b35;color:#f3f5e8;border-color:#193b35}
  .network-path figcaption {font-weight:600;font-size:clamp(1rem,1.5vw,1.3rem)}
  .network-path ol {display:flex;list-style:none;margin:1.5rem 0 0;padding:0}
  .network-path li {flex:1;min-width:0;position:relative;display:grid;justify-items:center;align-content:start;gap:.55rem;text-align:center;font-size:clamp(.75rem,1vw,.9rem)}
  .network-path li:not(:last-child)::after {content:"";position:absolute;top:1.5rem;left:calc(50% + 1.5rem);width:calc(100% - 3rem);border-top:1px solid currentColor;opacity:.5}
  .device {box-sizing:border-box;display:grid;place-items:center;width:3rem;height:3rem;border:1px solid currentColor;border-radius:50%}
  .device svg {height:1.55rem;width:1.55rem}
  @media(max-width:800px){.network-diagrams{grid-template-columns:1fr}}
  @media(max-width:800px){.security-hero,.chapter{grid-template-columns:1fr;gap:1.5rem}}
</style>
