---
import Layout from '../layouts/StoryLayout.astro';
import {copy, docsUrl, type Lang} from '../data/commercial';
interface Props { lang: Lang }
const {lang} = Astro.props;
const en = lang === 'en';
const security = copy[lang].security;
const steps = [
  {kind:'charger', title: en ? 'Chargers' : 'Laders', detail: en ? 'AC and DC' : 'AC en DC'},
  {kind:'controller', title: en ? 'On-site bastion' : 'Lokaal bastion', detail: 'UniPi Edge E410'},
  {kind:'cloud', title: en ? 'Platform' : 'Platform', detail: en ? 'Session data' : 'Sessiegegevens'}
];
const paths = [
  {name: en ? 'Stroomlijnen DC charger' : 'Stroomlijnen DC-lader', protocol: 'HTTPS · mTLS', receiver: en ? 'Bastion API' : 'Bastion-API'},
  {name: en ? 'OEM AC charger' : 'OEM-AC-lader', protocol: 'OCPP', receiver: en ? 'Local OCPP endpoint' : 'Lokaal OCPP-eindpunt'}
];
---
<Layout lang={lang} page="security" title="Cybersecurity" description={security.intro}>
  <header class="wrap guide-intro security-intro">
    <div><p class="eyebrow"><span></span>Cybersecurity</p>
      <h1>{en ? 'One site.' : 'Eén locatie.'}<br/><em>{en ? 'Clear boundaries.' : 'Heldere grenzen.'}</em></h1>
      <p class="lead">{en ? 'The chargers talk to the controller on site. The controller opens the connection to the platform. This keeps the charging network separate from the public internet.' : 'De laders communiceren met de regelaar op locatie. Die opent de verbinding met het platform. Zo blijft het laadnetwerk gescheiden van het openbare internet.'}</p>
    </div>
    <figure class="network-map">
      <figcaption>{security.diagramTitle}</figcaption>
      <ol>
        {steps.map((node,i) => <li class:list={['node',node.kind]}>
          <svg aria-hidden="true" viewBox="0 0 90 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
            {node.kind==='charger' ? <><path d="M24 55V12h30v43zm-4 0h38M30 18h18v12H30zm24 2h6l6 8v15q0 7-5 7t-5-7v-8"/><path d="m41 33-5 9h6l-3 8" stroke="#8cab48"/></> :
             node.kind==='controller' ? <><rect x="12" y="21" width="64" height="32" rx="3"/><path d="M12 29h64M17 22v-6h16v6m19-1V11h17M22 53v4h14v-4m21 0v4h12v-4"/><path d="M21 36h3m4 0h3m4 0h3" stroke="#a7ca69"/><path d="M48 43h18"/></> :
             <><path d="M23 48a11 11 0 0 1-1-22 18 18 0 0 1 34-6 14 14 0 0 1 9 28z"/><path d="M32 36h22m-18 6h15" stroke="#91ad64"/></>}
          </svg><strong>{node.title}</strong><small>{node.detail}</small>
          {i<2 && <span class="wire" aria-hidden="true">→</span>}
        </li>)}
      </ol>
      <p><i aria-hidden="true"></i>{en ? 'The bastion initiates the platform connection over WireGuard.' : 'Het bastion start de verbinding met het platform via WireGuard.'}</p>
    </figure>
  </header>
  <section class="wrap routes-section">
    <div><p class="eyebrow">{en ? 'Inside the site' : 'Op locatie'}</p>
      <h2>{en ? 'Two paths to the controller.' : 'Twee routes naar de regelaar.'}</h2>
      <p>{en ? 'The charging equipment determines which protocol reaches the bastion. Both paths terminate locally.' : 'Het type lader bepaalt via welk protocol de verbinding het bastion bereikt. Beide routes eindigen op locatie.'}</p>
    </div>
    <figure class="protocols">
      <figcaption>{en ? 'Charger communication' : 'Communicatie met de lader'}</figcaption>
      {paths.map(row => <div class="route"><strong>{row.name}</strong><span class="channel">{row.protocol}</span><strong>{row.receiver}</strong></div>)}
    </figure>
  </section>
  <section class="wrap principles" aria-label={en ? 'Security measures' : 'Beveiligingsmaatregelen'}>
    {security.principles.map(([heading,body])=><article><h3>{heading}</h3><p>{body}</p></article>)}
  </section>
  <section class="scope"><div class="wrap routes-section">
    <h2>{en ? 'What we check at your site' : 'Wat we op uw locatie toetsen'}</h2>
    <div><p>{security.commissioning}</p><p>{security.compliance}</p>
      <a class="text-link" href={docsUrl(lang,'security/architecture')}>{security.docsLink} <span aria-hidden="true">↗</span></a>
    </div>
  </div></section>
</Layout>
<style>
  .security-intro,.routes-section {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);align-items:center;gap:clamp(2rem,5vw,5rem);padding-block:clamp(3rem,6vw,6rem)}
  .security-intro h1 {font-size:clamp(3rem,5.5vw,6rem)}
  .lead,.routes-section p,.principles p {color:#4f605b;max-width:62ch}
  figure {min-width:0}
  .network-map {padding:clamp(1.2rem,3vw,2.6rem);color:#f4f4eb;background-color:#19343e;background-image:radial-gradient(#65808466 .7px,transparent .7px);background-size:13px 13px}
  figcaption {font-size:.82rem;font-weight:550;letter-spacing:.025em}
  .network-map ol {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;padding:2.6rem 0;margin:0;text-align:center}
  .node {position:relative;display:grid;justify-items:center;align-content:start}
  .node svg {width:clamp(3rem,7vw,6rem);height:auto;margin-bottom:.6rem;color:#e1ebd8}
  .node small {font-size:.73rem;color:#c8d9d5;margin-top:.4rem}
  .wire {position:absolute;left:92%;top:20%;color:#b4d57e;font-size:1.3rem}
  .network-map p {border-top:1px solid #78908e77;padding-top:1rem;font-size:.84rem;line-height:1.5}
  .network-map i {display:inline-block;width:.5rem;height:.5rem;border-radius:50%;background:#b3d979;margin-right:.5rem}
  .routes-section {border-top:1px solid var(--line)}
  .routes-section h2 {font-size:clamp(2.3rem,4vw,4rem);margin:.5rem 0 1rem}
  .protocols {padding:clamp(1rem,2.5vw,2rem);border:1px solid #c7d1bf;background:#e9edde}
  .route {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr) minmax(0,1fr);align-items:center;gap:1rem;margin-top:1rem;padding-top:1rem;border-top:1px solid #b8c6af;font-size:clamp(.82rem,1vw,1rem)}
  .channel {display:flex;flex-direction:column;align-items:center;gap:.4rem;color:#38564e;font-size:.8rem}
  .channel:after {content:'';width:100%;height:.55rem;background:#5f7f69;clip-path:polygon(0 42%,91% 42%,91% 0,100% 50%,91% 100%,91% 58%,0 58%)}
  .principles {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;padding-bottom:clamp(3rem,6vw,6rem)}
  .principles article {border-top:1px solid var(--line);padding-top:1rem}
  .principles h3 {margin-bottom:.8rem}
  .scope {background:#e9edde}
  .scope p+p {margin-top:.8rem}
  @media(max-width:800px){.security-intro,.routes-section,.principles{grid-template-columns:1fr}.wire{left:90%}.node strong{font-size:.85rem}.route{gap:.5rem}}
</style>
