---
import {docsOrigin} from '../../config/public-sites.mjs';
interface Props { lang: 'nl' | 'en' }
const {lang} = Astro.props;
---
<figure class="ems-diagram">
  <img src={`${docsOrigin}/img/ems-edge-e410.webp`} width="1536" height="1024" loading="lazy" decoding="async"
    alt={lang === 'en' ? 'The Stroomlijnen controller on the UniPi Edge E410 connects the meter, solar inverter and building systems to the 120 kW DC charger, ESS 261 battery and customer portal.' : 'De Stroomlijnen-regelaar op de UniPi Edge E410 verbindt de meter, zonne-omvormer en gebouwinstallaties met de 120 kW DC-snellader, de ESS 261 en het klantportaal.'} />
  <figcaption>{lang === 'en' ? 'The controller reads the meter and coordinates charging and storage with solar generation and building demand. The portal displays the data. Control runs on site.' : 'De regelaar leest de meter en stemt het laden en de batterij af op de opwek en het gebouwverbruik. Het portaal toont de gegevens. De regeling werkt op locatie.'}</figcaption>
</figure>
<style>
  .ems-diagram { margin: 0; }
  .ems-diagram img { display: block; width: 100%; height: auto; }
  .ems-diagram figcaption { margin-top: .6rem; font-size: .85rem; line-height: 1.5; }
</style>
