---
import SharedLayout from '../layouts/SharedLayout.astro';
import { copy, docsUrl, type Lang } from '../data/commercial';
import { gatewayOrigin, legacyPaths } from '../../config/public-sites.mjs';
import { siteAudience } from '../data/site-target';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
---
<SharedLayout lang={lang} page="contact">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Contact</p>
      <h1>{lang === 'en' ? 'Get in touch' : 'Neem contact op'}</h1>
      <p class="intro">{lang === 'en'
        ? 'Tell us about your venue, hotel, business or technical question. Your message goes to the Stroomlijnen team.'
        : 'Vertel ons over uw podium, hotel, bedrijf of technische vraag. Uw bericht komt bij het team van Stroomlijnen terecht.'}</p>
    </div>
  </section>
<section class="shell contact-grid"><div><h2>{c.contact.formTitle}</h2><form action="https://formspree.io/f/mlgpjlbn" method="POST">
  <input type="hidden" name="_next" value={new URL(legacyPaths[lang].receipt, gatewayOrigin).href} data-preview-receipt={siteAudience === 'preview' ? legacyPaths[lang].receipt : undefined}/><input type="hidden" name="_subject" value="Nieuw contactbericht via stroomlijnen.nl"/><input type="text" name="_gotcha" class="honeypot" tabindex="-1" aria-hidden="true" autocomplete="off"/>
  <div class="form-pair"><div><label for="naam">{c.contact.name} <span aria-hidden="true">*</span></label><input id="naam" name="naam" autocomplete="name" required/></div><div><label for="organisatie">{c.contact.company}</label><input id="organisatie" name="organisatie" autocomplete="organization"/></div></div>
  <label for="email">{c.contact.email} <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required/>
  <label for="type">{c.contact.sector}</label><select name="type" id="type"><option value="">{c.contact.choose}</option>{c.contact.options.map((s,i)=><option value={['hospitality','property','fleet','transport','cultuur','other'][i]}>{s}</option>)}</select>
  <label for="bericht">{c.contact.message} <span aria-hidden="true">*</span></label><textarea id="bericht" name="bericht" rows="6" required aria-describedby="message-hint"/><p id="message-hint" class="form-note">{c.contact.hint}</p><p class="form-note">{c.contact.privacy}</p><button class="button" type="submit">{c.contact.send} <span aria-hidden="true">↗</span></button>
 </form></div><aside class="contact-aside"><p class="eyebrow">Stroomlijnen B.V.</p><h2>{c.contact.direct}</h2><a class="contact-email" href="mailto:info@stroomlijnen.nl">info@stroomlijnen.nl</a><dl><dt>{c.contact.address}</dt><dd>Nieuwe Hemweg 4-A<br/>1013 BG Amsterdam</dd><dt>{c.contact.registration}</dt><dd>93264526</dd></dl><a class="text-link" href={docsUrl(lang)} target="_blank" rel="noopener noreferrer">{c.docs} ↗</a></aside></section>
</SharedLayout>
<script>
  const receipt = document.querySelector<HTMLInputElement>('[data-preview-receipt]');
  if (receipt?.dataset.previewReceipt) {
    receipt.value = new URL(receipt.dataset.previewReceipt, window.location.origin).href;
  }
</script>
