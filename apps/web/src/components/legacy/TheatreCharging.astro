---
import Layout from '../../layouts/Layout.astro';
import { contactEntry } from '../../data/site-target';

interface Props { lang: 'nl' | 'en' }
const { lang } = Astro.props;
const t = (nl: string, en: string) => lang === 'en' ? en : nl;
---
<Layout lang={lang} page="theatres" title={t("Voor theaters — laders en passief inkomen", "Charging for theatres")}>
<style>
.page-hero{background:linear-gradient(135deg,#0a1628,#0d1e38 60%,#091422);padding:7rem 0 5rem}
.page-hero h1{font-size:clamp(2rem,4vw,3rem);color:var(--white);margin-bottom:.75rem;max-width:800px}
.page-hero p{font-size:1.1rem;color:var(--text);max-width:640px;line-height:1.75;margin-bottom:2rem}

/* What you get */
.what-box{background:rgba(0,176,228,.04);border:1px solid rgba(0,176,228,.15);border-radius:10px;padding:2rem;margin-top:2rem}
.what-row{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
.what-title{color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:1rem}
.what-list{display:flex;flex-direction:column;gap:.5rem}
.what-item{display:flex;gap:.75rem;align-items:flex-start;padding:.5rem;border-radius:6px;background:rgba(255,255,255,.03)}
.what-icon{flex-shrink:0;margin-top:.1rem;width:.9rem;height:.9rem}
.what-icon svg{width:100%;height:100%}
.what-item p{color:var(--text);font-size:.88rem;line-height:1.55;margin:0}
.what-item strong{color:var(--white)}

/* Features */
.features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem;margin-top:2rem}
.feature-card{background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.15);border-radius:10px;padding:1.75rem}
.feature-card:hover{border-color:rgba(0,176,228,.35)}
.feature-icon{width:1.5rem;height:1.5rem;margin-bottom:.75rem}
.feature-icon svg{width:100%;height:100%}
.feature-card h3{color:var(--white);margin-bottom:.4rem;font-size:1rem}
.feature-card p{color:var(--text);font-size:.88rem;line-height:1.6}

/* Options */
.options-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-top:2rem}
.option-card{background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.15);border-radius:10px;padding:2rem}
.option-card.featured{border-color:var(--cyan)}
.option-label{font-size:.75rem;font-weight:700;color:var(--cyan);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem}
.option-card h3{color:var(--white);font-size:1.2rem;margin-bottom:.5rem}
.option-card>p{color:var(--text);font-size:.9rem;margin-bottom:1rem;line-height:1.6}
.option-card ul{list-style:none;margin-top:.75rem}
.option-card ul li{color:var(--text);font-size:.85rem;padding:.25rem 0 .25rem 1.25rem;position:relative}
.option-card ul li:before{content:"✓";color:var(--green);position:absolute;left:0}
.option-price{margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}
.option-price dt{font-size:.72rem;color:var(--gray);text-transform:uppercase;letter-spacing:.05em}
.option-price dd{color:var(--white);font-size:.9rem;margin-bottom:.4rem}

/* Roadmap */
.roadmap{display:flex;flex-direction:column;gap:1rem;margin-top:2rem}
.roadmap-item{background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.12);border-radius:8px;padding:1.5rem;display:flex;gap:1.5rem;align-items:flex-start}
.roadmap-phase{background:var(--cyan);color:var(--navy);font-size:.7rem;font-weight:700;padding:.25rem .6rem;border-radius:4px;white-space:nowrap;flex-shrink:0;margin-top:.15rem}
.roadmap-item h4{color:var(--white);margin-bottom:.25rem;font-size:.95rem}
.roadmap-item p{color:var(--text);font-size:.85rem;line-height:1.55;margin:0}

/* FAQ */
.faq{display:flex;flex-direction:column;gap:.75rem;margin-top:2rem}
.faq-item{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:1.5rem}
.faq-item h4{color:var(--white);margin-bottom:.4rem;font-size:.95rem}
.faq-item p{color:var(--text);font-size:.85rem;line-height:1.6;margin:0}

/* CTA */
.cta-block{text-align:center;padding:5rem 0}
.cta-block h2{color:var(--white);font-size:2rem;margin-bottom:1rem}
.cta-block p{color:var(--text);max-width:520px;margin:0 auto 2rem;line-height:1.7}
.disclaimer{font-size:.78rem;color:rgba(255,255,255,.35);border-top:1px solid rgba(255,255,255,.08);margin-top:1.5rem;padding-top:1rem;line-height:1.55}

@media(max-width:768px){
  .what-row{grid-template-columns:1fr}
}
</style>

  <section class="page-hero">
    <div class="container">
      <h1>{t("Laders voor theaters — passief inkomen, geen gedoe", "Charging for theatres, with income from every session")}</h1>
      <p>{t("Stroomlijnen installeert en beheert snelladers bij theaters. U ontvangt passief inkomen per geleverde kWh. Wij regelen de rest — van hardware tot administratie.", "Stroomlijnen installs and manages fast chargers at theatres. You earn income for each kWh supplied. We handle everything from the hardware to billing.")}</p>
    </div>
  </section>

  <!-- Wat u krijgt, wat wij doen -->
  <section>
    <div class="container">
      <p style="color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">{t("Wat u krijgt", "What you get")}</p>
      <h2 style="color:var(--white);font-size:1.8rem;margin-bottom:.5rem">{t("Een compleet laadpunt, volledig beheerd", "A fully managed charging point")}</h2>
      <p style="color:var(--text);max-width:700px;line-height:1.75;margin-bottom:1rem">{t("Vanaf de eerste dag dat er iemand laadt, verdient u mee. Zonder eigen investering in software, zonder storingsdienst, zonder administratieve rompslomp.", "You earn a share from the first charging session. We provide the software, handle faults and take care of the administration.")}</p>
      <div class="what-box">
        <div class="what-row">
          <div>
            <p class="what-title">{t("Stroomlijnen regelt", "What Stroomlijnen provides")}</p>
            <div class="what-list">
              <div class="what-item"><div class="what-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("DC-snellader", "DC fast charger")}</strong> {t("— 60—120 kW, modulair, CCS2", "— modular, 60–120 kW, CCS2")}</p></div>
              <div class="what-item"><div class="what-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>OCPP 2.0.1 platform</strong> {t("— eigen servers, eigen app, laadpassen", "— our own servers, app and charging cards")}</p></div>
              <div class="what-item"><div class="what-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>24/7 monitoring</strong> {t("— remote diagnose, respons binnen 4 uur", "— remote diagnostics and a response within four hours")}</p></div>
              <div class="what-item"><div class="what-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("Facturatie & inning", "Billing and collection")}</strong> {t("— alle administratie, maandelijkse uitbetaling", "— all administration and a monthly payout")}</p></div>
              <div class="what-item"><div class="what-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("CO₂-rapportage", "CO₂ reporting")}</strong> {t("— inzicht in besparing, klaar voor duurzaamheidsverslag", "— savings figures for your sustainability report")}</p></div>
              <div class="what-item"><div class="what-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("ERE-certificaten", "ERE certificates")}</strong> {t("— certificaten van hernieuwbare opwek naar Cultuurfonds", "— proceeds from renewable energy certificates go to the Cultuurfonds")}</p></div>
              <div class="what-item"><div class="what-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#84BD00" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("Mobiele backup-lader", "Mobile backup charger")}</strong> {t("— bij uitval staat er binnen 24 uur een vervanger", "— a replacement within 24 hours if the charger fails")}</p></div>
            </div>
          </div>
          <div>
            <p class="what-title">{t("Wat u doet", "What you provide")}</p>
            <div class="what-list">
              <div class="what-item"><div class="what-icon" style="width:.9rem;height:.9rem"><svg viewBox="0 0 24 24" fill="none" stroke="#84BD00" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("Plek vrijmaken", "Space for the charger")}</strong> {t("— bij het laaddok, dicht bij uw hoofdaansluiting", "— at the loading dock, close to your main electricity connection")}</p></div>
              <div class="what-item"><div class="what-icon" style="width:.9rem;height:.9rem"><svg viewBox="0 0 24 24" fill="none" stroke="#84BD00" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("Stroom leveren", "Electricity")}</strong> {t("— via uw bestaande aansluiting, overdag is er ruimte", "— from the daytime capacity on your existing connection")}</p></div>
              <div class="what-item"><div class="what-icon" style="width:.9rem;height:.9rem"><svg viewBox="0 0 24 24" fill="none" stroke="#84BD00" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("Internetverbinding", "Internet access")}</strong> {t("— bekabeld bij de lader", "— a wired connection at the charger")}</p></div>
              <div class="what-item"><div class="what-icon" style="width:.9rem;height:.9rem"><svg viewBox="0 0 24 24" fill="none" stroke="#84BD00" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("Installatie", "Installation")}</strong> {t("— aansluiten op de (hoofd)verdeelinstallatie door uw installateur", "— your installer connects the charger to your distribution board")}</p></div>
              <div class="what-item"><div class="what-icon" style="width:.9rem;height:.9rem"><svg viewBox="0 0 24 24" fill="none" stroke="#84BD00" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg></div><p><strong>{t("Inkomen ontvangen", "Receive your income")}</strong> {t("— maandelijks, per kWh, automatisch", "— automatic monthly payments for each kWh delivered")}</p></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Waarom nu -->
  <section>
    <div class="container">
      <p style="color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">{t("Waarom dit nu speelt", "Why this matters now")}</p>
      <h2 style="color:var(--white);font-size:1.8rem;margin-bottom:1rem">{t("Gebruik je stroomcapaciteit voordat je uit tourschema's valt", "Put spare capacity to work for touring productions")}</h2>
      <p style="color:var(--text);max-width:700px;line-height:1.75;margin-bottom:.75rem">{t("Producties willen elektrisch rijden, maar kunnen thuis niet laden: netcongestie blokkeert nieuwe aansluitingen op eigen terrein. Theaters hebben die stroomcapaciteit wél — en zijn precies de plekken waar trucks toch al staan.", "Productions want to go electric, but grid congestion can stop them getting the connection they need at their own depots. Theatres have capacity available where touring trucks already spend hours parked.")}</p>
      <p style="color:var(--text);max-width:700px;line-height:1.75;margin-bottom:1.5rem">{t("Zodra reizende producties hun routes plannen, worden laadmogelijkheden een voorwaarde. Theaters zonder laadpunt vallen simpelweg af — niet omdat het niet mag, maar omdat een tour anders logistiek niet sluitend is. Wie nú een lader plaatst, staat straks op elke route.", "As productions plan their routes, they need charging stops that fit the tour schedule. A theatre with a charger can become one of those stops.")}</p>
      <div class="features-grid">
        <div class="feature-card"><div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v4h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div><h3>{t("Trucks staan er toch al", "The trucks are already there")}</h3><p>{t("Productietruck staat bij het laaddok tijdens opbouw, voorstelling en afbouw — 8—16 uur laadtijd. Precies genoeg om een volle vrachtwagen op te laden.", "A production truck typically spends 8–16 hours at the loading dock during setup, the performance and load-out. That gives it time to recharge.")}</p></div>
        <div class="feature-card"><div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div><h3>{t("Uw aansluiting staat overdag stil", "Your grid connection has room during the day")}</h3><p>{t("Theaters zijn gedimensioneerd op avondpiekbelasting. Overdag is die capaciteit beschikbaar — zonder extra netkosten, zonder verzwaren.", "A theatre’s grid connection is designed for its evening peak. Daytime capacity can serve charging without an upgrade or additional grid charges.")}</p></div>
        <div class="feature-card"><div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div><h3>{t("18+ ZE-zones en groeiend", "More than 18 zero-emission zones and counting")}</h3><p>{t("Vanaf 2026 breiden zero-emissiezones uit. Dieselwagens worden geweerd. Een theaterlader is de enige manier om een tournee elektrisch te houden.", "Zero-emission zones are expanding from 2026 and restrict diesel vehicles. Charging at theatres helps electric tours reach city venues.")}</p></div>
      </div>
      <p style="color:var(--text);font-size:.85rem;line-height:1.6;margin-top:1rem;max-width:700px">{t("Het echte risico: producties touren straks alleen naar theaters waar ze ook kunnen laden. Zonder laadpunt bent u geen bestemming meer.", "Productions may increasingly choose venues where their trucks can recharge before the next leg of a tour.")}</p>
    </div>
  </section>

  <!-- Drie opties -->
  <section>
    <div class="container">
      <p style="color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">{t("Twee opties", "Two options")}</p>
      <h2 style="color:var(--white);font-size:1.8rem;margin-bottom:.5rem">{t("Kies het model dat bij u past", "Choose the model that fits your theatre")}</h2>
      <p style="color:var(--text);font-size:.9rem;max-width:640px;line-height:1.7;margin-bottom:1rem">{t("Of u nu volledig beheerd wilt worden of maximale controle zoekt — er is een passende optie.", "You can buy a managed charging service or run the charger yourself.")}</p>
      <div class="options-grid">
        <div class="option-card featured">
          <div class="option-label">{t("Optie A — Aanbevolen", "Option A · Recommended")}</div>
          <h3>{t("Aanschaf & beheerd", "Purchase with management included")}</h3>
          <p>{t("U bent direct eigenaar. Stroomlijnen beheert de lader, het platform en de administratie.", "You own the charger from day one. Stroomlijnen manages the charger, platform and administration.")}</p>
          <ul>
            <li>{t("SPRILA-subsidie tot 40% (theater dient zelf in)", "SPRILA grant of up to 40% (the theatre applies directly)")}</li>
            <li>{t("Geen aflossing of verrekeningen", "No repayments or reconciliations")}</li>
            <li>{t("Financiering restbedrag eventueel i.s.m. Cultuur+Ondernemen", "The remaining investment may be financed with Cultuur+Ondernemen")}</li>
            <li>{t("CPO + monitoring + 24/7 support + ERE + onderhoud", "Charge point operation, monitoring, 24/7 support, ERE and maintenance")}</li>
            <li>{t("Onderdeel van het culturele laadnetwerk", "Membership of the cultural charging network")}</li>
          </ul>
          <div class="option-price">
            <dt>{t("120 kW DC snellader", "120 kW DC fast charger")}</dt>
            <dd>{t("€27.000 excl. btw (na 25% theaterkorting)", "€27,000 excluding VAT (after a 25% theatre discount)")}</dd>
            <dt>{t("Inbegrepen", "Included")}</dt>
            <dd>{t("5 jaar CPO/eMSP platform, garantie, SLA, ingebruikstelling", "Five years of CPO/eMSP platform access, warranty, service agreement and commissioning")}</dd>
          </div>
        </div>
        <div class="option-card">
          <div class="option-label">{t("Optie B — Eigen regie", "Option B · Self-managed")}</div>
          <h3>{t("Zelfkoop, eigen exploitatie", "Buy and operate your own charger")}</h3>
          <p>{t("Maximale controle. U koopt de hardware, Stroomlijnen levert en stelt in bedrijf.", "You buy the hardware and manage operations. Stroomlijnen supplies and commissions the equipment.")}</p>
          <div class="option-price">
            <dt>{t("Investering 120 kW", "Investment for 120 kW")}</dt><dd>{t("€36.000 excl. btw", "€36,000 excluding VAT")}</dd>
            <dt>{t("SPRILA-subsidie", "SPRILA grant")}</dt><dd>{t("Tot 40% (theater dient zelf in)", "Up to 40% (the theatre applies directly)")}</dd>
            <dt>{t("Uw inkomsten", "Your income")}</dt><dd>{t("100% — u bepaalt tarief", "100% of revenue, with the rate set by you")}</dd>
            <dt>{t("Rekenvoorbeeld", "Worked example")}</dt><dd>{t("€0,20 delta × 32.000 kWh = €6.400/jr", "€0.20 margin × 32,000 kWh = €6,400 per year")}</dd>
          </div>
          <p style="color:var(--text);font-size:.8rem;margin-top:1rem">{t("✓ Stroomlijnen levert hardware, inbedrijfstelling en portal.", "✓ Stroomlijnen supplies the hardware, commissioning and portal.")}</p>
          <p style="color:var(--text);font-size:.8rem;margin-top:.5rem">{t("✗ Geen onderdeel van het culturele laadnetwerk", "✗ Cultural charging network membership is excluded.")}</p>
        </div>
      </div>
      <p class="disclaimer">{t("SPRILA 2026: Budget nog niet definitief goedgekeurd. Bedragen indicatief op basis van 40%-regeling MKB. Theater dient aanvraag zelf in. Energie: dynamisch (spotmarkt) of vast €0,35/kWh bij batterijopslag (ESS).", "The 2026 SPRILA budget was awaiting final approval when this offer was prepared. The figures illustrate the 40% SME scheme. The theatre submits its own application. Energy is priced dynamically on the spot market or at a fixed €0.35/kWh with battery storage (ESS).")}</p>
    </div>
  </section>

  <!-- Financieel voorbeeld -->
  <section>
    <div class="container">
      <p style="color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">{t("Financieel voorbeeld", "Financial example")}</p>
      <h2 style="color:var(--white);font-size:1.8rem;margin-bottom:.5rem">{t("Wat levert een snellader op?", "What could a fast charger earn?")}</h2>
      <p style="color:var(--text);font-size:.9rem;max-width:680px;line-height:1.7;margin-bottom:1rem">{t("Bij een 120 kW DC-lader in een gemiddeld theater, uitgaande van cultureel tarief en SPRILA-subsidie:", "This example assumes a 120 kW DC charger at a typical theatre, the cultural rate and a SPRILA grant.")}</p>
      <div style="background:rgba(0,176,228,.06);border:1px solid rgba(0,176,228,.2);border-radius:10px;padding:2rem">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1.5rem">
          <div>
            <p style="font-size:.72rem;color:var(--gray);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.2rem">{t("Investering lader (na korting)", "Charger investment after discount")}</p>
            <p style="font-size:1.3rem;font-weight:700;color:var(--white)">{t("€27.000", "€27,000")}</p>
          </div>
          <div>
            <p style="font-size:.72rem;color:var(--gray);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.2rem">{t("SPRILA-subsidie (40%)", "SPRILA grant (40%)")}</p>
            <p style="font-size:1.3rem;font-weight:700;color:var(--green)">{t("- €10.800", "−€10,800")}</p>
          </div>
          <div>
            <p style="font-size:.72rem;color:var(--gray);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.2rem">{t("Netto investering", "Net investment")}</p>
            <p style="font-size:1.3rem;font-weight:700;color:var(--white)">{t("€16.200", "€16,200")}</p>
          </div>
          <div>
            <p style="font-size:.72rem;color:var(--gray);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.2rem">{t("Jaarlijkse marge (bij 100% gebruik)", "Annual margin at full use")}</p>
            <p style="font-size:1.3rem;font-weight:700;color:var(--cyan)">{t("€7.820", "€7,820")}</p>
          </div>
          <div>
            <p style="font-size:.72rem;color:var(--gray);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.2rem">{t("Nettowinst na 10 jaar", "Net profit after ten years")}</p>
            <p style="font-size:1.3rem;font-weight:700;color:var(--green)">{t("€62.000", "€62,000")}</p>
          </div>
        </div>
      </div>
      <p style="color:var(--text);font-size:.78rem;margin-top:.75rem;line-height:1.5">{t("Rekenvoorbeeld op basis van: 34.000 kWh/jaar, cultuur 70% (€0,45), commercieel 20% (€0,60), op eigen terrein 10% (€0,00). Inkoopkosten €0,22/kWh. Groei: jaar 1 = 10%, jaar 3 = 70%, jaar 4—10 = 100%. Zie het infodocument voor het volledige rekenmodel.", "The model assumes 34,000 kWh per year. Cultural customers account for 70% at €0.45/kWh, commercial customers for 20% at €0.60/kWh, and on-site use for 10% at €0.00/kWh. Electricity costs €0.22/kWh. Use rises from 10% in year one to 70% in year three and 100% in years four to ten. The information pack contains the full model.")}</p>
      <p style="color:var(--text);font-size:.88rem;line-height:1.7;margin-top:1.25rem;max-width:700px">{t("De netto-investering is met SPRILA-subsidie beperkt tot €16.200 — en kan desgewenst worden gefinancierd. Zelfs in de minimale modus (alleen cultuurtarief, geen commerciële of openbare leveringen) verdient de lader zich op termijn terug. Wordt de laadtijd ook verkocht aan bijvoorbeeld een lokale aannemer, dan stijgt de opbrengst verder.", "With the grant in this example, the net investment is €16,200 and may be financed. The model projects a payback over time from cultural customers alone. Selling spare charging time to a local contractor, for example, can increase revenue.")}</p>
    </div>
  </section>

  <!-- ERE -->
  <section>
    <div class="container">
      <p style="color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">Cultuurfonds</p>
      <h2 style="color:var(--white);font-size:1.8rem;margin-bottom:1rem">{t("ERE-certificaten gaan terug naar de sector", "Certificate proceeds go back to the sector")}</h2>
      <p style="color:var(--text);max-width:700px;line-height:1.75;margin-bottom:1rem">{t("Elke kWh die via een Stroomlijnen-lader wordt geladen, genereert een ERE-certificaat (Garantie van Oorsprong). Dit is een officieel, verhandelbaar bewijs van hernieuwbare energieopwekking — met een marktwaarde.", "Each kWh delivered through a Stroomlijnen charger contributes to renewable energy certificates that can be traded.")}</p>
      <p style="color:var(--text);max-width:700px;line-height:1.75;margin-bottom:1rem">{t("Bij de meeste CPO's verdwijnt die opbrengst in de bedrijfsresultaten. Bij Stroomlijnen gaat de volledige ERE-opbrengst naar het Cultuurfonds, ten behoeve van projecten en makers op het gebied van muziek en theater.", "Stroomlijnen directs all ERE proceeds to the Cultuurfonds to support music and theatre projects and the people behind them.")}</p>
      <p style="color:var(--text);max-width:700px;line-height:1.75">{t("Dit is geen PR-verhaal: het staat in het contract. Eventuele overwinsten vloeien eveneens terug naar het Cultuurfonds.", "The contract sets out this commitment. Any surplus profits also go to the fund.")}</p>
      <div style="margin-top:1.5rem;background:rgba(0,176,228,.06);border:1px solid rgba(0,176,228,.2);border-radius:8px;padding:1.25rem">
        <p style="color:var(--text);font-size:.85rem;line-height:1.6;margin:0"><strong style="color:var(--white);">{t("Wat betekent dit voor uw theater?", "What does this mean for your theatre?")}</strong> {t("U helpt niet alleen transporteurs verduurzamen, maar ook mensen die anders de aansluiting missen. Het Cultuurfonds beslist volledig onafhankelijk over de besteding.", "You help transport operators switch to electric and support people who might otherwise be left out. The Cultuurfonds independently decides how to distribute the money.")}</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="container">
      <p style="color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">FAQ</p>
      <h2 style="color:var(--white);font-size:1.8rem;margin-bottom:1rem">{t("Veelgestelde vragen", "Frequently asked questions")}</h2>
      <div class="faq">
        <div class="faq-item"><h4>{t("Hebben we genoeg capaciteit op onze aansluiting?", "Does our grid connection have enough capacity?")}</h4><p>{t("Waarschijnlijk wel. Theaters zijn gedimensioneerd op avondpiekbelasting. Overdag staat die capaciteit grotendeels stil — precies de ruimte die we gebruiken voor laden. Een 60 kW lader laadt in 10 uur ruim voldoende voor een volle vrachtwagen. Ons EMS begrenst de lader automatisch binnen uw gecontracteerd vermogen.", "Theatres are usually sized for the evening peak. During the day the charger can use much of that capacity. A 60 kW charger can deliver a full truck charge over ten hours. Our energy management system automatically keeps demand within your contracted limit.")}</p></div>
        <div class="faq-item"><h4>{t("Gaat het laden ten koste van onze voorstelling?", "Will charging affect our performance?")}</h4><p>{t("Nee. Het Stroomlijnen-platform monitort real-time uw gebouwverbruik en begrenst de lader. Uw voorstelling heeft altijd prioriteit. Laden gebeurt vooral overdag en 's nachts.", "The performance always takes priority. The platform monitors building demand in real time and limits the charger accordingly. Charging takes place mainly during the day and overnight.")}</p></div>
        <div class="faq-item"><h4>{t("Welk vermogen hebben we nodig?", "How much power do we need?")}</h4><p>{t("Minimaal 60 kW DC — daarmee laadt een elektrische trekker-oplegger in 7—10 uur volledig op. Een 120 kW lader is optimaal: u laadt overdag snel bij en kunt 's avonds stoppen. Het theater gebruikt die stroomcapaciteit overdag toch niet. Een 22 kW AC-lader volstaat voor lichte bestelwagens en tourbussen.", "A 60 kW DC charger can recharge an electric tractor unit in 7–10 hours. A 120 kW charger tops up faster during the day, letting you pause for the evening performance. A 22 kW AC charger can serve light vans and tour minibuses.")}</p></div>
        <div class="faq-item"><h4>{t("Wat kost het ons? Wat levert het op?", "What does it cost, and what can we earn?")}</h4><p>{t("De opties staan hierboven — van €27.000 (volledig beheerd) tot €36.000 (eigen regie). De netto-investering is met SPRILA-subsidie beperkt en kan desgewenst worden gefinancierd. Zelfs in de minimale modus (alleen cultuurtarief, geen commerciële of openbare leveringen) verdient de lader zich op termijn terug. Wordt de laadtijd ook verkocht aan bijvoorbeeld een lokale aannemer, dan stijgt de opbrengst verder. Het beheer, platform en administratie zijn voor rekening van Stroomlijnen.", "The options range from €27,000 for managed operation to €36,000 for self-management. The SPRILA grant can reduce the investment and financing may be available. In the example above, cultural charging alone pays back over time. Selling spare time to local businesses can increase revenue. Stroomlijnen covers management, platform operation and administration under the managed option.")}</p></div>
        <div class="faq-item"><h4>{t("Hoe zit het met veiligheid en verzekering?", "How are safety and insurance handled?")}</h4><p>{t("Stroomlijnen levert gecertificeerde hardware (CE, MID, NEN 1010) met automatische foutdetectie, noodstop en branddetectiekoppeling. Laders zijn onzichtbaar op internet via een privaat Tailscale-netwerk — geen open poorten, geen externe toegang. Elke lader heeft een eigen digitaal paspoort. Het systeem voldoet aan NIS2-normen.", "Stroomlijnen supplies certified hardware (CE, MID, NEN 1010) with automatic fault detection, an emergency stop and a fire detection interface. A private Tailscale network isolates the chargers from the public internet. Each charger has its own digital passport. The system is designed to meet NIS2 requirements.")}</p></div>
        <div class="faq-item"><h4>{t("Wat als we huren van de gemeente?", "What if the municipality owns our building?")}</h4><p>{t("Dan heeft u toestemming nodig van de eigenaar. Stroomlijnen begeleidt dit traject en kan technische documentatie aanleveren voor gemeente of verhuurder.", "You need permission from the owner. Stroomlijnen helps with the process and can provide technical documentation for the municipality or landlord.")}</p></div>
        <div class="faq-item"><h4>{t("Wie installeert en onderhoudt?", "Who installs and maintains the charger?")}</h4><p>{t("Installatie door uw eigen installateur. Stroomlijnen doet de inbedrijfstelling en is verantwoordelijk voor alle onderhoud, software-updates en 24/7 monitoring.", "Your own installer makes the connection. Stroomlijnen commissions the charger and handles maintenance, software updates and 24/7 monitoring.")}</p></div>
        <div class="faq-item"><h4>{t("Hoe lang duurt het voordat de lader er staat?", "How long does installation take?")}</h4><p>{t("Vanaf bestelling is levering 2—4 weken. Installatie + inbedrijfstelling kost 1—2 dagen.", "Delivery takes 2–4 weeks from order. Installation and commissioning take 1–2 days.")}</p></div>
      </div>
    </div>
  </section>

  <!-- Roadmap -->
  <section>
    <div class="container">
      <p style="color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">Roadmap</p>
      <h2 style="color:var(--white);font-size:1.8rem;margin-bottom:.5rem">{t("Van snellader naar energieknooppunt", "From fast charger to local energy hub")}</h2>
      <p style="color:var(--text);margin-bottom:1rem;font-size:.9rem">{t("Elke fase bouwt voort op de vorige. U begint met een snellader en passief inkomen. Uw systeem groeit mee zonder extra kapitaalinzet.", "Each phase builds on the last. You start with a fast charger and charging income, then expand the system over time without a further capital outlay.")}</p>
      <div class="roadmap">
        <div class="roadmap-item"><span class="roadmap-phase">{t("Nu beschikbaar", "Available now")}</span><div><h4>{t("Fase 1 — Snellader & platform", "Phase 1 · Fast charger and platform")}</h4><p>{t("DC-snellader op uw terrein. OCPP 2.0.1 platform, 24/7 monitoring, CO₂-rapportage, facturatie. Passief inkomen vanaf dag één.", "A DC fast charger on your premises, with an OCPP 2.0.1 platform, 24/7 monitoring, CO₂ reporting and billing. You earn income from the first session.")}</p></div></div>
        <div class="roadmap-item"><span class="roadmap-phase">{t("Pilot 2026—2027", "Pilot 2026–2027")}</span><div><h4>{t("Fase 2 — Zonnepanelen & batterij", "Phase 2 · Solar panels and battery storage")}</h4><p>{t("Batterijopslag en zonnepanelen op uw dak. Lokaal opgewekte energie voor laden én eigen verbruik. Slim EMS.", "Battery storage and rooftop solar work with an energy management system to supply charging and building demand with locally generated electricity.")}</p></div></div>
        <div class="roadmap-item"><span class="roadmap-phase">{t("2027—2028", "2027–2028")}</span><div><h4>{t("Fase 3 — Slim laden & peakshaving", "Phase 3 · Smart charging and peak shaving")}</h4><p>{t("Batterij maakt een vast laadtarief mogelijk. Inkopen bij lage prijs, leveren aan vast tarief. Ook peakshaving voor eigen verbruik.", "Storage lets you buy when prices are low and charge drivers a fixed rate. The battery can also reduce the building’s peak demand.")}</p></div></div>
        <div class="roadmap-item"><span class="roadmap-phase">{t("Toekomstvisie", "Future plans")}</span><div><h4>{t("Fase 4 — Theater als energiehub", "Phase 4 · The theatre as an energy hub")}</h4><p>{t("Uw theater als lokaal energieknooppunt: laden, opslaan, terugleveren, V2G. Bij netuitval fungeert het als lokaal energiepunt.", "The theatre could charge, store and export electricity locally, including through vehicle-to-grid charging. It could also supply local power during an outage.")}</p></div></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="container cta-block">
      <h2>{t("Vrijblijvend adviesgesprek?", "Discuss your venue")}</h2>
      <p>{t("Wij beoordelen uw situatie, netaansluiting en mogelijkheden. Geen verplichtingen, wel een concreet advies op maat.", "We’ll look at your site, its grid connection and the options available, and give you specific advice without obligation.")}</p>
      <a href={contactEntry(lang)} class="btn btn-primary">{t("Plan een gesprek →", "Arrange a conversation →")}</a>
    </div>
  </section>
</Layout>
