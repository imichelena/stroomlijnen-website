---
import '../styles/fonts.css';
import '../styles/story.css';
import { storyRoutes, type StoryLanguage } from '../data/home-story';
import { commercialPaths } from '../../config/public-sites.mjs';
import { commercialCanonical, gatewayHome, siteAudience } from '../data/site-target';
interface Props { lang?: StoryLanguage; page?: 'home' | 'hardware' | 'security'; title?: string; description?: string; }
const { lang = 'nl', page = 'home' } = Astro.props;
const en = lang === 'en';
const title = Astro.props.title ?? (en ? 'Room to move forward' : 'Ruimte om vooruit te gaan');
const description = Astro.props.description ?? (en
 ? 'Your business wants to grow. Stroomlijnen brings your building, charging, solar and storage together. Smart energy management starts with your working day.'
 : 'Uw bedrijf wil verder. Stroomlijnen laat gebouw, laden, zon en opslag samenwerken. Slim energiemanagement begint bij uw werkdag.');
const routes = storyRoutes[lang];

const otherLanguage = en ? 'nl' : 'en';
const otherRoute = page === 'home' ? storyRoutes[otherLanguage].home : commercialPaths[otherLanguage][page];
const canonical = commercialCanonical(commercialPaths[lang][page]);
---
<!doctype html>
<html lang={lang}>
 <head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title} | Stroomlijnen</title>
  <meta name="description" content={description}/>
  {siteAudience === 'preview' && <meta name="robots" content="noindex, nofollow"/>}
  <link rel="canonical" href={canonical}/>
  <link rel="alternate" hreflang="nl" href={commercialCanonical(commercialPaths.nl[page])}/>
  <link rel="alternate" hreflang="en" href={commercialCanonical(commercialPaths.en[page])}/>
  <link rel="alternate" hreflang="x-default" href={commercialCanonical(commercialPaths.nl[page])}/>
  <link rel="icon" href="/favicon-commercial.svg"/>
  <meta name="theme-color" content="#f5f4ef"/>
  <meta property="og:title" content={`${title} | Stroomlijnen`}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:locale" content={en ? 'en_GB' : 'nl_NL'}/>
  <meta property="og:locale:alternate" content={en ? 'nl_NL' : 'en_GB'}/>
  <meta property="og:image" content={commercialCanonical('/images/itgwo/main-stage-04275-1600.webp')}/>
 </head>
 <body class="stroom-story">
  <a class="skip-link" href="#main">{en ? 'Skip to content' : 'Naar de inhoud'}</a>
  <div class="reading-progress" aria-hidden="true"></div>
  <header class="site-header">
   <a class="wordmark" href={gatewayHome(lang)} aria-label={en ? 'Stroomlijnen home' : 'Stroomlijnen startpagina'}><img src="/stroomlijnen-logo-docs.png" alt="Stroomlijnen" width="219" height="37"/></a>
   <button class="nav-toggle" aria-expanded="false" aria-controls="story-nav">Menu <span aria-hidden="true">+</span></button>
   <nav id="story-nav" aria-label={en ? 'Main navigation' : 'Hoofdnavigatie'}>
    <a href={routes.home} aria-current={page === 'home' ? 'page' : undefined}>{en ? 'Overview' : 'Overzicht'}</a>
    <a href={routes.hardware} aria-current={page === 'hardware' ? 'page' : undefined}>Hardware</a>
    <a href={routes.security} aria-current={page === 'security' ? 'page' : undefined}>Cybersecurity</a>
    <a href={routes.about}>{en ? 'About us' : 'Over ons'}</a>
    <a href={routes.knowledge} target="_blank" rel="noopener noreferrer">{en ? 'Knowledge base' : 'Kennisbank'} <span aria-hidden="true">↗</span></a>
    <a class="nav-cta" href={routes.contact}>{en ? 'Let’s talk' : 'Laten we praten'} <span aria-hidden="true">↗</span></a>
   </nav>
   <a class="language-switch" data-language-switch href={otherRoute} lang={otherLanguage} hreflang={otherLanguage} aria-label={en ? 'Naar de Nederlandse website' : 'Switch to English'}>{en ? 'NL' : 'EN'} <span aria-hidden="true">↗</span></a>
  </header>
  <main id="main"><slot/></main>
  <footer class="story-footer wrap">
   <div class="footer-main">
    <div><a class="wordmark" href={gatewayHome(lang)}><img src="/stroomlijnen-logo-docs.png" width="219" height="37" alt="Stroomlijnen" loading="lazy"/></a><p>{en ? 'Energy that works.' : 'Energie die werkt.'}<br/>{en ? 'For everything you want to do.' : 'Voor alles wat u wilt doen.'}</p></div>
    <div><span class="small-label">{en ? 'A good conversation starts here' : 'Een goed gesprek begint hier'}</span><a class="footer-mail" href="mailto:info@stroomlijnen.nl">info@stroomlijnen.nl <span aria-hidden="true">↗</span></a><p>Nieuwe Hemweg 4-A<br/>1013 BG Amsterdam</p></div>
    <nav aria-label={en ? 'Footer navigation' : 'Footernavigatie'}>
     <a href={gatewayHome(lang)}>{en ? 'All sectors' : 'Alle sectoren'}</a>
     <a href={routes.hardware}>Hardware</a>
     <a href={routes.security}>Cybersecurity</a>
     <a href={routes.docs} target="_blank" rel="noopener noreferrer">{en ? 'Documentation' : 'Documentatie'} <span aria-hidden="true">↗</span></a>
     <a data-language-switch href={otherRoute} lang={otherLanguage} hreflang={otherLanguage}>{en ? 'Nederlands' : 'English'} <span aria-hidden="true">↗</span></a>
    </nav>
   </div>
   <div class="footer-bottom"><span>© 2026 Stroomlijnen B.V.</span><span>{en ? 'Energy, charging and control. Designed to work together.' : 'Energie, laden en besturing. In samenhang ontworpen.'}</span><span>{en ? 'Chamber of Commerce' : 'KVK'} 93264526</span></div>
  </footer>
  <script>import '../scripts/energy-story';</script>
 </body>
</html>
