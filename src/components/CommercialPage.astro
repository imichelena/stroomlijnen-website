---
import Layout from '../layouts/CommercialLayout.astro';
import Architecture from './CommercialArchitecture.astro';
import Fieldwork from './CommercialFieldwork.astro';
import {copy,routes,docsUrl,type Lang,type Page} from '../data/commercial';
interface Props {lang:Lang; page:Page}
const {lang,page}=Astro.props;const c=copy[lang];const p=c[page];const r=routes[lang];
const team=[['Ignacio Michelena','ignacio'],['Jacco Patist','jacco']];
---
<Layout lang={lang} page={page}>
 <section class:list={['hero shell',{'home-hero':page==='home'}]}>
  <div class="hero-copy"><p class="eyebrow">{p.eyebrow}</p><h1>{p.title.split('\n').map((line,i)=><><span class={i===1?'second-line':''}>{line}</span>{i===0&&<br/>}</>)}</h1><p class="intro">{p.intro}</p>
   {page==='home'&&<div class="hero-actions"><a class="button" href={r.contact}>{c.discuss}<span aria-hidden="true">↗</span></a><a class="text-link" href={r.technology}>{c.discover} <span aria-hidden="true">→</span></a></div>}
  </div>
  {page==='home'&&<figure class="hero-photo"><img src="/images/charger-120kw-v2.jpg" alt={lang==='nl'?'DC-laadconnector met elektrische vrachtwagen op de achtergrond':'DC charging connector with an electric truck in the background'} width="1280" height="853" fetchpriority="high"/><figcaption><span>{c.home.caption}</span><span aria-hidden="true">01 — DC</span></figcaption></figure>}
 </section>
 {page==='home'&&<>
  <div class="capability-strip shell">{c.home.strip.map((item,i)=><span><b>0{i+1}</b>{item}</span>)}</div>
  <section class="section shell editorial"><div><p class="eyebrow">{c.home.kicker}</p><h2>{c.home.heading}</h2></div><div><p class="lead">{c.home.body}</p><div class="numbered-list">{c.home.items.map(([title,text],i)=><article><span class="index">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div></div></section>
  <section class="security-band"><div class="shell security-teaser"><div><p class="eyebrow">{c.nav[2]}</p><h2>{c.home.securityTitle}</h2><p>{c.home.securityText}</p><a class="text-link" href={r.security}>{c.security.docsLink} <span aria-hidden="true">→</span></a></div><div class="layer-stack" aria-label={lang==='nl'?'Drie architectuurlagen':'Three architecture layers'}>{[[c.security.cloud,c.security.cloudText],[c.security.bastion,c.security.bastionText],[c.security.dc,lang==='nl'?'Eigen applicatielaag op DC-laders':'Our application layer on DC chargers']].map(([title,text],i)=><div><span>0{3-i}</span><div><h3>{title}</h3><p>{text}</p></div></div>)}<p class="stack-note">{lang==='nl'?'Architectuurlagen · OEM-AC volgt een afzonderlijk lokaal OCPP-pad.':'Architecture layers · OEM AC follows a separate local OCPP path.'}</p></div></div></section>
  <section class="section shell"><div class="section-intro"><h2>{c.home.sectorTitle}</h2><p>{c.home.sectorText}</p></div><div class="sector-links">{c.applications.sectors.map(([title,text],i)=><a href={`${r.applications}#sector-${i}`}><span class="index">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>
 </>}
 {(['home','applications'].includes(page))&&<section class="mist-band"><div class="shell section editorial"><h2>{lang==='nl'?'Van meetgegevens naar een passend ontwerp.':'From measured demand to a site-specific design.'}</h2><div><p class="lead">{lang==='nl'?'Met onze meet- en analysetools brengen we het vermogensgebruik van uw locatie in beeld. Dat vormt, samen met uw aansluitgrenzen en laadbehoefte, de basis voor het ontwerp.':'We use our measurement and analysis tools to understand your site’s power demand. Together with connection limits and charging needs, that evidence forms the basis of the design.'}</p><p>{lang==='nl'?'Waar nodig meten we op locatie het totale vermogen en de belasting per fase. Metingen laten zien wat er gebeurt; de analyse helpt ons de inzet van laden, energiemanagement en eventuele opslag te beoordelen. Het resultaat is een locatiegericht ontwerp, geen standaardpakket of gegarandeerde besparing.':'Where needed, we measure total power and per-phase demand on site. Measurements show what happens; the analysis helps us assess charging, energy management and optional storage. The result is a site-specific design—not a standard package or a guaranteed saving.'}</p><a class="text-link" href={docsUrl(lang,'energie/netcongestie')}>{lang==='nl'?'Lees meer over vermogen en netcongestie in onze documentatie':'Learn more about power capacity and grid congestion in our documentation'} →</a></div></div></section>}
 {page==='technology'&&<>
  <nav class="section-nav shell" aria-label={lang==='nl'?'Op deze pagina':'On this page'}>{c.home.strip.map((label,i)=><a href={`#technology-${i}`}>0{i+1} / {label}</a>)}</nav>
  <div class="shell">{c.technology.rows.map(([label,title,text,note],i)=><section id={`technology-${i}`} class="technology-row"><div><p class="eyebrow">{label}</p><h2>{title}</h2></div><div><p class="lead">{text}</p><p>{note}</p>{i===0&&<a class="text-link" href={docsUrl(lang,'energie/ems')}>{lang==='nl'?'Energiemanagement in onze documentatie':'Explore energy management in our documentation'} →</a>}{i===1&&<a class="text-link" href={docsUrl(lang,'energie/ess')}>{lang==='nl'?'Batterijopslag in onze documentatie':'Explore battery storage in our documentation'} →</a>}{i===3&&<a class="text-link" href={docsUrl(lang,'klantportaal/overview')}>{lang==='nl'?'Klantportaal in onze documentatie':'Explore the customer portal in our documentation'} →</a>}{i===2&&<a class="text-link" href={docsUrl(lang,'pandeneigenaren/ac-vs-dc-laders')}>{lang==='nl'?'AC en DC in onze documentatie':'Compare AC and DC charging in our documentation'} →</a>}</div>{i===2&&<div class="product-lineup">{c.technology.products.map(([title,text,img])=><figure><img loading="lazy" src={`/images/${img}`} width="600" height="440" alt={title}/><figcaption><h3>{title}</h3><p>{text}</p></figcaption></figure>)}</div>}</section>)}</div>
  <section class="mist-band"><div class="shell section editorial"><h2>{c.technology.recognitionTitle}</h2><div><p class="lead">{c.technology.recognition}</p><p>{c.technology.recognitionNote}</p><a class="text-link" href={docsUrl(lang,'plug-and-charge/setup-guide')}>{c.technology.recognitionLink} ↗</a></div></div></section>
 </>}
 {page==='security'&&<>
  <div class="shell"><Architecture lang={lang}/></div>
  <section class="section shell"><div class="security-principles">{c.security.principles.map(([title,text],i)=><article><span class="index">0{i+1}</span><h2>{title}</h2><p>{text}</p></article>)}</div></section>
  <section class="mist-band"><div class="shell section editorial"><h2>{c.security.complianceTitle}</h2><div><p class="lead">{c.security.compliance}</p><p>{c.security.commissioning}</p><a class="text-link" href={docsUrl(lang,'security/architecture')}>{c.security.docsLink} ↗</a></div></div></section>
 </>}
 {page==='applications'&&<>
  <div class="shell applications-list">{c.applications.sectors.map(([title,heading,text,consider],i)=><section class="application" id={`sector-${i}`}><div class="application-label"><span class="index">0{i+1}</span><p class="eyebrow">{title}</p></div><div><h2>{heading}</h2><p class="lead">{text}</p><div class="consider"><h3>{c.applications.consider}</h3><p>{consider}</p></div></div></section>)}</div>
  <section class="mist-band"><div class="shell section"><h2>{c.applications.processTitle}</h2><ol class="process">{c.applications.steps.map(([title,text],i)=><li><span class="index">0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
 </>}
 {page==='about'&&<>
  <section class="shell editorial about-intro"><h2>{c.about.heading}</h2><p class="lead">{c.about.body}</p></section>
  <section class="mist-band"><div class="shell section lab"><figure><img src="/images/charger-120kw-v2.jpg" alt={lang==='nl'?'DC-lader en vrachtwagen bij de praktijkinstallatie':'DC charger and truck at the practical installation'} width="1280" height="853" loading="lazy"/><figcaption>Lichtwerk · Amsterdam</figcaption></figure><div><p class="eyebrow">Living lab</p><h2>{c.about.labTitle}</h2><p>{c.about.labText}</p><a class="text-link" href={r.technology}>{c.discover} →</a></div></div></section>
  <section class="shell section"><h2>{c.about.team}</h2><div class="team">{team.map(([name,id],i)=><article><img src={`/team-${id}.jpg`} alt={name} width="400" height="440" loading="lazy"/><h3>{name}</h3><p class="role">{c.about.roles[i]}</p><p>{c.about.teamText[i]}</p></article>)}</div></section>
 </>}
 {(['applications','about'].includes(page))&&<Fieldwork lang={lang}/>}
 {page==='contact'&&<section class="shell contact-grid"><div><h2>{c.contact.formTitle}</h2><form action="https://formspree.io/f/mlgpjlbn" method="POST">
  <input type="hidden" name="_next" value="https://stroomlijnen.nl/thanks"/><input type="hidden" name="_subject" value="Nieuw contactbericht via stroomlijnen.nl"/><input type="text" name="_gotcha" class="honeypot" tabindex="-1" aria-hidden="true" autocomplete="off"/>
  <div class="form-pair"><div><label for="naam">{c.contact.name} <span aria-hidden="true">*</span></label><input id="naam" name="naam" autocomplete="name" required/></div><div><label for="organisatie">{c.contact.company}</label><input id="organisatie" name="organisatie" autocomplete="organization"/></div></div>
  <label for="email">{c.contact.email} <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required/>
  <label for="type">{c.contact.sector}</label><select name="type" id="type"><option value="">{c.contact.choose}</option>{c.contact.options.map((s,i)=><option value={['hospitality','property','fleet','transport','other'][i]}>{s}</option>)}</select>
  <label for="bericht">{c.contact.message} <span aria-hidden="true">*</span></label><textarea id="bericht" name="bericht" rows="6" required aria-describedby="message-hint"/><p id="message-hint" class="form-note">{c.contact.hint}</p><p class="form-note">{c.contact.privacy}</p><button class="button" type="submit">{c.contact.send} <span aria-hidden="true">↗</span></button>
 </form></div><aside class="contact-aside"><p class="eyebrow">Stroomlijnen B.V.</p><h2>{c.contact.direct}</h2><a class="contact-email" href="mailto:info@stroomlijnen.nl">info@stroomlijnen.nl</a><dl><dt>{c.contact.address}</dt><dd>Nieuwe Hemweg 4-A<br/>1013 BG Amsterdam</dd><dt>{c.contact.registration}</dt><dd>93264526</dd></dl><a class="text-link" href={docsUrl(lang)}>{c.docs} ↗</a></aside></section>}
</Layout>
