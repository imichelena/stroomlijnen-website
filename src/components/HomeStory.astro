---
import Layout from '../layouts/StoryLayout.astro';
import EnergyCampus from './EnergyCampus.astro';
import SectorScene from './SectorScene.astro';
import BenefitVisual from './BenefitVisual.astro';
import { homeStory, storyRoutes, storyIds, storySectors } from '../data/home-story';
interface Props { lang?: 'nl' | 'en'; }
const { lang = 'nl' } = Astro.props;
const c = homeStory[lang];
const routes = storyRoutes[lang];
const ids = storyIds[lang];
const sectors = storySectors[lang];
---
<Layout lang={lang}>
<section class="hero wrap" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow"><span></span> {c.heroEyebrow}</p><h1 id="hero-title"><Fragment set:html={c.heroTitle}/></h1><p class="hero-intro">{c.heroIntro}</p><a class="button button-dark" href={routes.contact}>{c.heroCta} <span aria-hidden="true">↗</span></a><a class="scroll-link" href={`#${ids.story}`}><span aria-hidden="true">↓</span> {c.heroScroll}</a></div><div class="hero-art"><div class="art-topline"><span>{c.artTopline}</span><span>SL / 01</span></div><EnergyCampus idPrefix="hero-campus" lang={lang}/><div class="hero-art-note"><span class="live-dot" aria-hidden="true"></span><span>{c.artNote}</span><button class="motion-control" data-home-motion type="button" aria-pressed="false">{c.pause}</button><span class="schematic">{c.schematic}</span></div></div><div class="hero-bottom"><span><Fragment set:html={c.heroBottom}/></span><div><span>{c.energyManagement}</span><i aria-hidden="true"></i><span>{c.smartCharging}</span><i aria-hidden="true"></i><span>{c.storageSolar}</span></div><a href={`#${ids.story}`} aria-label={c.readStory}>↓</a></div></section>
<section class="intro-section wrap" id={ids.story} aria-labelledby="intro-title"><div class="section-index" data-reveal><span>{c.challengeEyebrow}</span><span class="small-cross" aria-hidden="true">+</span></div><div class="intro-heading" data-reveal><h2 id="intro-title"><Fragment set:html={c.challengeTitle}/></h2><p>{c.challengeBody}</p></div><div class="problem-line" data-reveal><span>{c.yourBuilding}</span><span>{c.plusVehicles}</span><span>{c.plusPlans}</span><span class="problem-total">{c.sameConnection} <span aria-hidden="true">↴</span></span></div><div class="intro-conclusion" data-reveal><span class="small-label">{c.newPerspective}</span><p><Fragment set:html={c.timingMessage}/></p><a class="text-link" href={`#${ids.day}`}>{c.viewDay} <span aria-hidden="true">↓</span></a></div></section>
<section class="day-story" id={ids.day} aria-labelledby="day-title"><div class="wrap day-heading"><p class="eyebrow">{c.dayEyebrow}</p><h2 id="day-title"><Fragment set:html={c.dayTitle}/></h2><p><Fragment set:html={c.dayIntro}/></p></div><div class="wrap day-layout"><div class="day-chapters">
<article class="day-chapter is-active" data-day="0" id={ids.morning}><span class="chapter-number">01 / 04</span><time>08:00</time><h3><Fragment set:html={c.morningTitle}/></h3><p>{c.morningBody}</p><span class="chapter-result"><i></i> {c.morningResult}</span></article>
<article class="day-chapter" data-day="1" id={ids.midday}><span class="chapter-number">02 / 04</span><time>12:00</time><h3><Fragment set:html={c.middayTitle}/></h3><p>{c.middayBody}</p><span class="chapter-result"><i></i> {c.middayResult}</span></article>
<article class="day-chapter" data-day="2" id={ids.peak}><span class="chapter-number">03 / 04</span><time>17:00</time><h3><Fragment set:html={c.peakTitle}/></h3><p>{c.peakBody}</p><span class="chapter-result"><i></i> {c.peakResult}</span></article>
<article class="day-chapter" data-day="3" id={ids.night}><span class="chapter-number">04 / 04</span><time>22:00</time><h3><Fragment set:html={c.nightTitle}/></h3><p>{c.nightBody}</p><span class="chapter-result"><i></i> {c.nightResult}</span></article></div>
<div class="day-sticky"><div class="day-visual" data-current-day="0"><div class="visual-header"><div><span class="small-label">{c.dayVisualTitle}</span><strong class="visual-time">08:00</strong></div><span class="day-state">{c.startingUp}</span></div><div class="capacity-gauge"><div><span>{c.gridDemand}</span><strong><span id="grid-value">90</span><small> / 100 kW</small></strong></div><div class="gauge-track"><span id="grid-gauge" style="width:90%"></span><i></i></div><p>{c.limitCaption}</p></div><div class="energy-rails">
<div class="rail-row"><span class="rail-icon" aria-hidden="true">▥</span><span>{c.yourBuilding}</span><div class="rail-track"><i id="building-bar" style="width:65%"></i></div><strong><span id="building-value">65</span> <small>kW</small></strong></div><div class="rail-row charging-rail"><span class="rail-icon" aria-hidden="true">↗</span><span>{c.vehiclesCharging}</span><div class="rail-track"><i id="charging-bar" style="width:30%"></i></div><strong><span id="charging-value">30</span> <small>kW</small></strong></div><div class="rail-row solar-rail"><span class="rail-icon" aria-hidden="true">☼</span><span>{c.fromRoof}</span><div class="rail-track"><i id="solar-bar" style="width:5%"></i></div><strong><span id="solar-value">5</span> <small>kW</small></strong></div><div class="rail-row battery-rail"><span class="rail-icon" aria-hidden="true">▤</span><span id="battery-label">{c.batteryRest}</span><div class="rail-track"><i id="battery-bar" style="width:0%"></i></div><strong><span id="battery-value">0</span> <small>kW</small></strong></div></div><div class="day-insight"><span aria-hidden="true">↳</span><p id="day-insight">{c.morningInsight}</p></div><nav class="day-selector" aria-label={c.chooseMoment}><a href={`#${ids.morning}`} class="is-active" data-day-link="0" aria-current="step">08:00</a><a href={`#${ids.midday}`} data-day-link="1">12:00</a><a href={`#${ids.peak}`} data-day-link="2">17:00</a><a href={`#${ids.night}`} data-day-link="3">22:00</a></nav><p class="illustration-note">{c.illustrativeNote}</p></div></div></div></section>
<section class="benefits wrap" id={ids.solution} aria-labelledby="benefits-title"><div class="section-index" data-reveal><span>{c.benefitsEyebrow}</span><span class="small-cross" aria-hidden="true">+</span></div><div class="benefits-heading" data-reveal><h2 id="benefits-title"><Fragment set:html={c.benefitsTitle}/></h2><p>{c.benefitsIntro}</p></div><div class="benefits-grid">
<article data-reveal><BenefitVisual kind="capacity" lang={lang}/><span class="benefit-nr">01</span><h3><Fragment set:html={c.capacityTitle}/></h3><p>{c.capacityBody}</p></article>
<article data-reveal><BenefitVisual kind="storage" lang={lang}/><span class="benefit-nr">02</span><h3><Fragment set:html={c.solarTitle}/></h3><p>{c.solarBody}</p></article>
<article data-reveal><BenefitVisual kind="overview" lang={lang}/><span class="benefit-nr">03</span><h3><Fragment set:html={c.overviewTitle}/></h3><p>{c.overviewBody}</p></article></div><div class="technology-link"><p><Fragment set:html={c.technologyMessage}/></p><a class="text-link" href={routes.knowledge}>{c.knowledgeLink} <span aria-hidden="true">↗</span></a></div></section>
<section class="sectors-section" id={ids.sectors} aria-labelledby="sector-title"><div class="wrap"><div class="section-index" data-reveal><span>{c.sectorsEyebrow}</span><span class="small-cross" aria-hidden="true">+</span></div><div class="sectors-heading" data-reveal><h2 id="sector-title"><Fragment set:html={c.sectorsTitle}/></h2><p>{c.sectorsIntro}</p></div><div class="sector-explorer" data-reveal><div class="sector-tabs" role="tablist" aria-label={c.industryAria}>{sectors.map((s,i)=><button type="button" role="tab" id={`sector-tab-${i}`} aria-selected={i===0?'true':'false'} aria-controls={`sector-panel-${i}`} tabindex={i===0?0:-1} data-sector={i}><span>0{i+1}</span>{s.name}<i aria-hidden="true">↗</i></button>)}</div><div class="sector-panels">{sectors.map((s,i)=><article id={`sector-panel-${i}`} role="tabpanel" aria-labelledby={`sector-tab-${i}`} hidden={i!==0} tabindex="0"><div class={`sector-sketch sector-${s.shape}`} aria-hidden="true"><SectorScene kind={s.shape} lang={lang}/></div><span class="small-label">{s.label}</span><h3>{s.headline}</h3><p>{s.text}</p><div class="sector-need"><span aria-hidden="true">✓</span>{s.need}</div><a class="text-link" href={routes.contact}>{c.discussSite} <span aria-hidden="true">↗</span></a></article>)}</div></div></div></section>
<section class="practice-section wrap" id={ids.about} aria-labelledby="practice-title"><div class="practice-copy" data-reveal><p class="eyebrow">{c.practiceEyebrow}</p><h2 id="practice-title"><Fragment set:html={c.practiceTitle}/></h2><p class="practice-lead">{c.practiceLead}</p><p>{c.practiceBody}</p><a class="text-link" href={routes.about}>{c.teamLink} <span aria-hidden="true">↗</span></a></div><figure class="practice-photo" data-reveal><img src="/images/itgwo/main-stage-04275-1600.webp" srcset="/images/itgwo/main-stage-04275-960.webp 960w, /images/itgwo/main-stage-04275-1600.webp 1600w" sizes="(max-width:800px) 100vw, 55vw" width="1600" height="1067" loading="lazy" alt={c.practiceAlt}/><div class="photo-overlay"><span>{c.practiceOverlay}</span><strong><Fragment set:html={c.practicePhotoTitle}/></strong></div><figcaption>{c.practiceCaption}<br/><span>{c.photoCredit}</span></figcaption></figure></section>
<section class="process-section wrap" aria-labelledby="process-title"><div data-reveal><p class="eyebrow">{c.processEyebrow}</p><h2 id="process-title"><Fragment set:html={c.processTitle}/></h2></div><ol class="process-list"><li data-reveal><span>01</span><h3>{c.listenTitle}</h3><p>{c.listenBody}</p></li><li data-reveal><span>02</span><h3>{c.connectTitle}</h3><p>{c.connectBody}</p></li><li data-reveal><span>03</span><h3>{c.deliverTitle}</h3><p>{c.deliverBody}</p></li></ol></section>
<section class="contact-band"><div class="wrap"><p class="eyebrow">{c.contactEyebrow}</p><h2><Fragment set:html={c.contactTitle}/></h2><div><p><Fragment set:html={c.contactBody}/></p><a class="button button-light" href={routes.contact}>{c.contactCta} <span aria-hidden="true">↗</span></a></div><svg class="contact-lines" viewBox="0 0 500 500" aria-hidden="true"><path d="M50 500V270Q50 180 140 180H330Q420 180 420 90V0M90 500V310Q90 220 180 220H370Q460 220 460 130V0M10 500V230Q10 140 100 140H290Q380 140 380 50V0"/></svg></div></section>
</Layout>
