---
interface Props { lang: 'nl' | 'en' }
const { lang } = Astro.props;
const nl = lang === 'nl';
const labels = nl
 ? ['Gebouw', 'Laden uit het net', 'Laden met zon']
 : ['Building', 'Grid charging', 'Solar charging'];
const slots = [
 { time:'08:00', title:nl?'Aankomst':'Arrival', building:45, charging:35, solar:0 },
 { time:'11:00', title:nl?'Gebouwpiek':'Building peak', building:80, charging:15, solar:10 },
 { time:'14:00', title:nl?'Zonnevenster':'Solar window', building:45, charging:40, solar:50 },
 { time:'22:00', title:nl?'Gunstig tarief':'Low tariff', building:20, charging:70, solar:0 },
];
---
<figure class="day-timeline site-illustration">
 <div class="day-chart-heading"><strong>{nl?'Ruimte op dezelfde aansluiting':'Room on the same connection'}</strong><span>{nl?'Illustratief · kW':'Illustrative · kW'}</span></div>
 <ul class="day-legend" aria-label={nl?'Legenda':'Legend'}>{labels.map((label,i)=><li><i class={`day-key band-${i}`}></i>{label}</li>)}</ul>
 <div class="day-chart">
  {slots.map((slot,i)=><div class="day-slot">
   <div class="day-slot-title"><time>{slot.time}</time><span>{slot.title}</span></div>
   <div class="day-plot" role="img" aria-label={`${slot.time}: ${labels[0]} ${slot.building} kW, ${labels[1]} ${slot.charging} kW, ${labels[2]} ${slot.solar} kW. ${nl?'Netafname':'Grid draw'} ${slot.building+slot.charging} / 100 kW.`}>
    <span class="day-limit">100</span>
    <div class="day-stack" style={`--slot:${i}`}>
     {[slot.building,slot.charging,slot.solar].map((value,band)=><span class={`day-band band-${band}`} style={`height:${value/1.5}%`}>{value>0 && <b>{value}</b>}</span>)}
    </div>
   </div>
   <p class="day-net">{nl?'Net':'Grid'} <strong>{slot.building+slot.charging}</strong> / 100 kW</p>
  </div>)}
 </div>
 <figcaption>{nl?'Stippellijn: aansluitlimiet van 100 kW. Blauw + cyaan = netafname; groen is extra laadvermogen uit eigen zon. Illustratief, geen meetgegevens.':'Dashed line: 100 kW grid limit. Navy + cyan = grid draw; green adds charging power from on-site solar. Illustrative, not measured data.'}</figcaption>
</figure>
