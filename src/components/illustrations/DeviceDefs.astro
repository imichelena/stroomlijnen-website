---
// Each illustration owns its paint servers: desktop/mobile SVGs never share IDs.
interface Props { prefix: string }
const { prefix: p } = Astro.props;
const id = (name: string) => `${p}-${name}`;
const paint = (name: string) => `url(#${id(name)})`;
---
<defs>
 <linearGradient id={id('porcelain')} x2=".8" y2="1"><stop stop-color="#fff"/><stop offset="1" stop-color="#B8C7D6"/></linearGradient>
 <linearGradient id={id('metal')} x2="1" y2=".7"><stop stop-color="#45627D"/><stop offset="1" stop-color="#0C2340"/></linearGradient>
 <linearGradient id={id('glass')} x2="1" y2="1"><stop stop-color="#00B0E4"/><stop offset=".45" stop-color="#255E7C"/><stop offset="1" stop-color="#0A1628"/></linearGradient>
 <linearGradient id={id('solar')} x2="1" y2="1"><stop stop-color="#285879"/><stop offset=".5" stop-color="#0C2340"/><stop offset="1" stop-color="#007DA3"/></linearGradient>
 <linearGradient id={id('current')} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="600" y2="400"><stop stop-color="#00B0E4" stop-opacity=".1"/><stop offset=".65" stop-color="#00B0E4"/><stop offset="1" stop-color="#BDF3FF"/></linearGradient>
 <radialGradient id={id('halo')}><stop stop-color="#00B0E4" stop-opacity=".32"/><stop offset="1" stop-color="#00B0E4" stop-opacity="0"/></radialGradient>
 <filter id={id('glow')} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3"/></filter>
 <pattern id={id('cells')} width="16" height="13" patternUnits="userSpaceOnUse"><rect width="16" height="13" fill={paint('solar')}/><path d="M0 0H16V13H0Z" fill="none" stroke="#75BBD3" stroke-opacity=".6" stroke-width=".65"/><path d="M4 1V12M12 1V12" stroke="#A7DCEB" stroke-opacity=".18" stroke-width=".5"/></pattern>
 <pattern id={id('dots')} width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="#607E99" opacity=".24"/></pattern>
 <!-- Roof and facades share a 2:1 axonometric projection. -->
 <g id={id('building')}>
  <path d="M4 187L133 252L281 178L153 115Z" fill="#041326" opacity=".16"/>
  <path d="M0 75L130 140V235L0 170Z" fill={paint('porcelain')}/>
  <path d="M130 140L260 75V170L130 235Z" fill="#8FA7BD"/>
  <path d="M0 75L130 10L260 75L130 140Z" fill="#F2F5F8"/>
  <path d="M8 75L130 14L252 75L130 136Z" fill="#C6D4DF"/>
  <path d="M8 75L130 14V21L15 79Z" fill="#94ABBD"/>
  <path d="M0 75L130 140L260 75V82L130 147L0 82Z" fill="#fff"/>
  <path d="M130 147L260 82V88L130 153Z" fill="#607E99"/>
  <g transform="matrix(1 .5 0 1 10 89)">
   {[0,1,2,3,4,5].map(n => <g transform={`translate(${n*19} 0)`}><rect width="13" height="37" rx="1" fill={paint('glass')}/><path d="M1 2V34M1 19H12" stroke="#93C8D9" stroke-width=".7"/><path d="M3 2H10L3 17Z" fill="#BDF3FF" opacity=".2"/><rect y="39" width="14" height="2" fill="#fff"/></g>)}
   <path d="M0 52H110M0 58H110M0 64H110" stroke="#A8BBCB" stroke-width=".7"/>
  </g>
  <g transform="matrix(1 -.5 0 1 140 153)">
   {[0,1,2,3,4].map(n => <g transform={`translate(${n*22} 0)`}><rect width="16" height="23" rx="1" fill={paint('glass')}/><path d="M2 2H14M8 2V22" stroke="#95C9DB" stroke-width=".7"/><path d="M0 27H16" stroke="#D5E1EA" stroke-width="2"/></g>)}
   <rect x="10" y="40" width="38" height="34" fill="#0C2340"/><path d="M12 42H46V72H12ZM29 42V72" fill="none" stroke="#81A3BC" stroke-width="1"/>
   <rect x="64" y="39" width="40" height="35" fill="#657F96"/>{[0,1,2,3,4,5].map(n => <path d={`M66 ${43+n*5}H102`} stroke="#B8C7D6" stroke-width="1"/>)}
   <path d="M5 39H52L55 34H8Z" fill="#E4EDF3"/>
  </g>
  <g transform="matrix(1 .5 -1 .5 125 27)">
   <rect x="0" y="5" width="102" height="86" rx="2" fill="#607E99"/>
   <rect width="102" height="86" rx="2" fill="#F2F5F8"/>
   <rect x="3" y="3" width="96" height="80" fill={paint('cells')}/>
   <path class="solar-shimmer" d="M5 5H36L82 81H51Z" fill="#BDF3FF" opacity=".13"/>
   <path d="M51 3V83M3 43H99" stroke="#B8C7D6" stroke-width="1.5"/>
  </g>
 </g>
 <g id={id('battery')}>
  <path d="M-6 108L49 134L90 113L32 88Z" fill="#041326" opacity=".18"/>
  <path d="M0 14L49 37V121L0 98Z" fill={paint('porcelain')}/>
  <path d="M49 37L77 23V107L49 121Z" fill="#607E99"/>
  <path d="M0 14L28 0L77 23L49 37Z" fill="#F2F5F8"/>
  <g transform="matrix(1 .47 0 1 7 25)">
   <rect width="34" height="70" rx="2" fill="#E3EBF1" stroke="#A0B4C6" stroke-width=".7"/>
   <rect x="5" y="7" width="24" height="15" rx="2" fill="#0C2340"/>
   <rect class="device-led" x="9" y="12" width="14" height="3" rx="1.5" fill="#84BD00"/>
   {[0,1,2,3,4,5].map(n => <rect x="5" y={32+n*4} width="24" height="1.5" rx=".75" fill="#7A94AA"/>)}
   <circle cx="29" cy="26" r="1.3" fill="#607E99"/><path d="M16 59L12 65H17L15 69L22 62H17L20 59Z" fill="#84BD00"/>
  </g>
  <path d="M56 46V98M62 43V95M68 40V92" stroke="#395771" stroke-width="1.4"/>
  <path d="M0 98L49 121L77 107V113L49 127L0 104Z" fill="#0C2340"/>
 </g>
 <g id={id('charger')}>
  <ellipse cx="30" cy="118" rx="35" ry="12" fill="#041326" opacity=".18"/>
  <path d="M9 105L34 116L54 106L29 95Z" fill="#607E99"/>
  <path d="M14 12Q14 7 19 9L38 18V109L14 98Z" fill={paint('porcelain')}/>
  <path d="M38 18L51 11V102L38 109Z" fill="#5D7C96"/>
  <path d="M14 10L27 3Q29 2 33 4L48 10Q52 11 49 13L38 19Z" fill="#F2F5F8"/>
  <g transform="matrix(1 .45 0 1 18 20)">
   <rect width="16" height="51" rx="3" fill="#0C2340"/>
   <rect class="device-led" x="3" y="5" width="10" height="2" rx="1" fill="#00B0E4"/>
   <rect x="3" y="14" width="10" height="13" rx="1" fill="#2A5573"/><path d="M5 18H11M5 21H9" stroke="#86DFF6" stroke-width=".8"/>
   <rect x="5" y="35" width="7" height="11" rx="2" fill="#071626"/><path d="M7 37L10 39V44H7Z" fill="#B8C7D6"/>
   <path d="M3 66H13M3 70H13" stroke="#91A8BB" stroke-width="1"/>
  </g>
  <path d="M47 36C68 37 64 60 64 78S57 104 50 92C46 85 51 68 35 64" fill="none" stroke="#0A1628" stroke-width="2" stroke-linecap="round"/>
  <path d="M47 36C68 37 64 60 64 78S57 104 50 92" fill="none" stroke="#597C96" stroke-width="1"/>
  <path d="M31 56L38 60L38 69L31 65Z" fill="#0C2340"/><path d="M32 56L36 58" stroke="#00B0E4" stroke-width="2"/>
 </g>
 <g id={id('hub')}>
  <ellipse class="hub-glow" cx="70" cy="56" rx="90" ry="65" fill={paint('halo')}/>
  <path d="M3 60L67 93Q72 96 78 93L140 62V48L72 16L3 48Z" fill="#071322"/>
  <path d="M3 48L67 80Q72 83 78 80L140 48L76 16Q71 13 65 16Z" fill={paint('metal')} stroke="#5A819E" stroke-width="1"/>
  <path d="M16 48L71 21L127 48L72 75Z" fill="#0A1628"/>
  <path d="M25 48L71 26L118 48L72 70Z" fill="#123954" stroke="#00B0E4" stroke-width="1"/>
  <path d="M4 62L69 94L139 61" fill="none" stroke="#00B0E4" stroke-width="1.5"/>
  {[0,1,2,3,4].map(n => <path d={`M${21+n*9} ${68+n*4.5}v5`} stroke="#60829D" stroke-width="2"/>)}
  <text x="72" y="53" text-anchor="middle" fill="#E7F8FF" font-family="Inter,Arial,sans-serif" font-size="16" font-weight="600" letter-spacing="2">EMS</text>
  <circle class="device-led" cx="116" cy="68" r="2" fill="#84BD00"/>
 </g>
 <g id={id('transformer')}>
  <path d="M-5 110L66 145L122 117L50 82Z" fill="#020C18" opacity=".3"/>
  <path d="M0 100L64 132L112 108V118L64 142L0 110Z" fill="#49657D"/>
  <path d="M8 39L64 67V127L8 99Z" fill={paint('porcelain')}/>
  <path d="M64 67L104 47V107L64 127Z" fill="#6D889E"/>
  <path d="M8 39L48 19L104 47L64 67Z" fill="#DFEAF2"/>
  <g transform="matrix(1 .5 0 1 15 52)">
   {[0,1,2,3,4,5,6].map(n => <rect x={n*6} width="3" height="40" rx="1" fill="#7F98AC"/>)}
  </g>
  <g transform="matrix(1 -.5 0 1 71 73)"><rect width="24" height="34" rx="2" fill="#29475F"/><path d="M12 5L5 18H12L9 29L20 14H13L16 5Z" fill="#84BD00"/></g>
  {[0,1,2].map(n => <g transform={`translate(${31+n*21} ${24+n*10})`}><path d="M-4 0V-19H4V0" fill="#839FB5"/><path d="M-6 -15H6M-6 -10H6M-6 -5H6" stroke="#0C2340" stroke-width="2"/><ellipse cy="-20" rx="4" ry="2" fill="#DCE9F1"/></g>)}
 </g>
 <g id={id('van')}>
  <path d="M-3 72L92 119L160 85L70 40Z" fill="#041326" opacity=".18"/>
  <path d="M4 26L62 0L112 24L55 52Z" fill="#F2F5F8"/>
  <path d="M4 26L55 52V100L4 76Z" fill={paint('porcelain')}/>
  <path d="M55 52L112 24L134 46L151 58V83L55 100Z" fill="#8FA8BD"/>
  <path d="M61 55L110 31L126 48L61 80Z" fill={paint('glass')}/>
  <path d="M89 42V65M62 58L108 36" stroke="#AECFDF" stroke-width="1.5"/>
  <path d="M61 80L126 48L151 58L87 91Z" fill="#DBE6EF"/>
  <path d="M87 91L151 58V83L87 113Z" fill="#B1C4D4"/>
  <path d="M98 95L141 74V81L98 102Z" fill="#0C2340"/><path d="M93 93L102 89M136 72L146 67" stroke="#E8FAFF" stroke-width="2"/>
  <path d="M10 36L47 54V74L10 57Z" fill="#EAF1F6"/><path d="M10 60L47 78V83L10 65Z" fill="#00B0E4"/>
  <ellipse cx="24" cy="82" rx="9" ry="13" transform="rotate(-20 24 82)" fill="#0A1628"/><ellipse cx="24" cy="82" rx="4" ry="7" fill="#90A8BD"/>
  <ellipse cx="113" cy="99" rx="9" ry="13" transform="rotate(20 113 99)" fill="#0A1628"/><ellipse cx="113" cy="99" rx="4" ry="7" fill="#90A8BD"/>
 </g>
</defs>
