---
import DeviceDefs from './DeviceDefs.astro';
interface Props { variant: 'hero' | 'wide' | 'compact'; lang: 'nl' | 'en' }
const { variant, lang } = Astro.props;
const p = `energy-${variant}`;
const en = lang === 'en';
const hero = variant === 'hero';
const compact = variant === 'compact';
const ref = (name: string) => `#${p}-${name}`;
const paint = (name: string) => `url(${ref(name)})`;
const labels = en ? ['Solar', 'Building', 'Storage', 'Charging'] : ['Zon', 'Gebouw', 'Opslag', 'Laden'];
const flowLabels = en ? ['Your connection', 'Your EMS', 'Your building', 'Your vehicles'] : ['Uw aansluiting', 'Uw EMS', 'Uw gebouw', 'Uw voertuigen'];
const title = hero ? (en ? 'Your site as one energy system' : 'Uw locatie als één energiesysteem') : (en ? 'Sharing power across your site' : 'Stroom verdelen op uw locatie');
const desc = hero ? (en ? 'A business building with solar panels, battery storage and chargers, connected through one EMS.' : 'Een bedrijfsgebouw met zonnepanelen, batterijopslag en laders, verbonden via één EMS.') : (en ? 'A grid connection supplies local power management. It adjusts charging to building demand, within the available capacity.' : 'Een aansluiting levert stroom aan de lokale verdeling. Die stemt het laden af op wat het gebouw gebruikt, binnen de beschikbare ruimte.');
const traces = hero ? ['M143 359L220 398L362 327', 'M335 290L375 310V365', 'M389 385L443 412L480 394', 'M444 412L498 439L537 420'] : compact ? ['M160 172L189 187L235 164', 'M235 164L300 197V280L245 308', 'M235 164L119 222V372L171 398L310 468'] : ['M225 280L267 301L342 264', 'M342 264L417 226L480 258L585 205', 'M342 264L440 313L514 276L735 386'];
---
<svg class:list={['energy-art', hero ? 'hero-scene' : `flow-${variant}`]} viewBox={hero ? '0 0 600 480' : compact ? '0 0 360 570' : '0 0 800 440'} role="img" aria-labelledby={`${p}-title ${p}-desc`}>
 <title id={`${p}-title`}>{title}</title><desc id={`${p}-desc`}>{desc}</desc>
 <DeviceDefs prefix={p}/>
 {hero ? <>
  <rect width="600" height="480" rx="10" fill="#F2F5F8"/>
  <ellipse cx="350" cy="276" rx="240" ry="210" fill="#E7EFF4"/>
  <circle cx="350" cy="240" r="170" fill="none" stroke="#D5E2EB" stroke-width="1"/>
  <circle cx="350" cy="240" r="215" fill="none" stroke="#DCE6EE" stroke-width="1" stroke-dasharray="2 7"/>
  <path d="M34 316L277 194L573 342V361L329 483L34 335Z" fill="#C3D2DE"/>
  <path d="M34 316L277 194L573 342L329 464Z" fill="#E0E9F0"/>
  <path d="M34 316L329 464L573 342" fill="none" stroke="#fff" stroke-width="1.5"/>
  <g fill="none" stroke="#C7D7E3" stroke-width=".8"><path d="M80 293L375 441M131 268L426 416M182 242L477 390M233 217L528 365M85 341L329 219M137 367L381 245M189 393L433 271M241 419L485 297M293 445L537 323"/></g>
  <path d="M36 314L277 194L574 342L331 463Z" fill="none" stroke="#A9BDCC" stroke-width="5"/>
  <path d="M45 319L119 282L414 430L340 467Z" fill="#B7C9D6"/>
  <path d="M123 280L151 266L447 414L419 428Z" fill="#EDF2F5"/>
  <path d="M165 260L209 238L541 404L497 426Z" fill="#CEDBE5"/>
  <g fill="none" stroke="#F8FBFD" stroke-width="2.5"><path d="M43 325L316 462M64 315L338 452" stroke-dasharray="13 10"/><path d="M366 390L430 422L566 354M403 372L469 403M442 353L508 384M481 334L547 365"/></g>
  <path d="M107 341L240 408L370 343L500 408" fill="none" stroke="#819DB0" stroke-width="9"/>
  <path d="M107 341L240 408L370 343L500 408" fill="none" stroke="#C6D7E2" stroke-width="6" stroke-dasharray="2 5"/>
  <use href={ref('van')} transform="translate(24 105) scale(.8)"/>

 </> : <>
  <rect x="1" y="1" width={compact ? 358 : 798} height={compact ? 568 : 438} rx="16" fill="#0C1C30" stroke="#253C53" stroke-width="1"/>
  <rect width={compact ? 360 : 800} height={compact ? 570 : 440} fill={paint('dots')}/>
  <ellipse cx={compact ? 180 : 400} cy={compact ? 255 : 219} rx={compact ? 150 : 265} ry="160" fill={paint('halo')} opacity=".45"/>
  <g fill="none" stroke-linejoin="round">
   <path d={compact ? 'M14 194L170 116L346 204V425L180 550L14 467Z' : 'M15 306L355 136L784 285V399L532 427Z'} fill="#172F43" stroke="#365368" stroke-width="2"/>
   <path d={compact ? 'M20 450L166 523L339 437M20 466L166 539L339 453' : 'M25 335L202 423M46 325L223 413M500 414L768 280M535 425L781 302'} stroke="#7E98A9" stroke-width="2" stroke-dasharray="12 8"/>
   <path d={compact ? 'M64 188L120 216V370L300 460' : 'M129 288L275 361L446 276L737 397'} stroke="#456278" stroke-width="12"/>
   <path d={compact ? 'M64 188L120 216V370L300 460' : 'M129 288L275 361L446 276L737 397'} stroke="#8DA5B6" stroke-width="7" stroke-dasharray="2 6"/>
  </g>
 </>}
 <!-- Traces sit under the devices, so connections terminate at real ports. -->
 <g fill="none" stroke-linecap="round" stroke-linejoin="round">
  {traces.map(d => <path d={d} stroke={hero ? '#AFCDDB' : '#28465F'} stroke-width="2"/>)}
  {traces.map((d, i) => <g class:list={['current-trace', hero && i < 2 && 'solar-current']} style={`--trace-delay:${i * -.8}s`}>
   <path d={d} stroke={hero && i < 2 ? '#84BD00' : '#00B0E4'} stroke-width="2" filter={paint('glow')} opacity=".85"/>
   <path d={d} stroke={hero && i < 2 ? '#84BD00' : paint('current')} stroke-width="2"/>
  </g>)}
 </g>
 {hero ? <>
  <use href={ref('building')} transform="translate(120 5) scale(1.65)"/>
  <use href={ref('battery')} transform="translate(25 225) scale(1.12)"/>
  <use href={ref('battery')} transform="translate(88 258) scale(1.12)"/>
  <use href={ref('charger')} transform="translate(437 270) scale(1.15)"/>
  <use href={ref('charger')} transform="translate(493 298) scale(1.15)"/>
  <use href={ref('van')} transform="translate(180 350) scale(1)"/>
  <use href={ref('hub')} transform="translate(285 318) scale(1.1)"/>
  <g fill="#041326" opacity=".12"><ellipse cx="54" cy="81" rx="36" ry="15"/><ellipse cx="550" cy="230" rx="32" ry="14"/></g>
  <g stroke="#647F50" stroke-width="5"><path d="M54 77V40M550 229V190"/></g>
  <g fill="#598B20"><ellipse cx="54" cy="43" rx="30" ry="27"/><ellipse cx="550" cy="190" rx="27" ry="26"/><ellipse cx="51" cy="413" rx="27" ry="14"/></g>
  <g fill="#94BE53"><ellipse cx="48" cy="34" rx="23" ry="20"/><ellipse cx="544" cy="181" rx="20" ry="18"/><ellipse cx="45" cy="407" rx="22" ry="11"/></g>
  <g class="scene-leaders" fill="none" stroke="#7892A7" stroke-width="1"><path d="M302 27V43L326 62"/><path d="M549 151H570V123"/><path d="M28 327H12V366"/><path d="M537 420V451H490"/></g>
  <g class="scene-labels" fill="#39566E"><text x="302" y="20" text-anchor="middle">{labels[0]}</text><text x="550" y="112" text-anchor="middle">{labels[1]}</text><text x="12" y="384">{labels[2]}</text><text x="490" y="470" text-anchor="middle">{labels[3]}</text></g>
  <g fill="#00B0E4"><circle cx="326" cy="62" r="2.5"/><circle cx="549" cy="151" r="2.5"/><circle cx="28" cy="327" r="2.5"/><circle cx="537" cy="420" r="2.5"/></g>
 </> : compact ? <>
  <use href={ref('transformer')} transform="translate(12 18) scale(1.45)"/>
  <use href={ref('hub')} transform="translate(140 55) scale(1.32)"/>
  <use href={ref('building')} transform="translate(80 160) scale(.98)"/>
  <use href={ref('charger')} transform="translate(278 335) scale(1.1)"/>
  <use href={ref('van')} transform="translate(130 410) scale(1.3)"/>
  <use href={ref('battery')} transform="translate(12 270) scale(1)"/>
  <g class="scene-labels flow-device-labels" fill="#B8C7D6"><text x="80" y="16" text-anchor="middle">{flowLabels[0]}</text><text x="235" y="36" text-anchor="middle">{flowLabels[1]}</text><text x="215" y="406" text-anchor="middle">{flowLabels[2]}</text><text x="65" y="548" text-anchor="middle">{flowLabels[3]}</text></g>
  <g stroke="#45647E" stroke-width="1"><path d="M80 23V43M235 44V76M215 386V393M130 531H65V536"/></g>
 </> : <>
  <use href={ref('transformer')} transform="translate(20 55) scale(1.95)"/>
  <use href={ref('hub')} transform="translate(225 210) scale(1.65)"/>
  <use href={ref('building')} transform="translate(440 10) scale(1.12)"/>
  <use href={ref('charger')} transform="translate(700 220) scale(1.4)"/>
  <use href={ref('van')} transform="translate(530 265) scale(1.4)"/>
  <use href={ref('battery')} transform="translate(330 55) scale(1.3)"/>
  <g class="scene-labels flow-device-labels" text-anchor="middle" fill="#B8C7D6"><text x="130" y="383">{flowLabels[0]}</text><text x="342" y="412">{flowLabels[1]}</text><text x="410" y="28">{flowLabels[2]}</text><text x="455" y="428">{flowLabels[3]}</text></g>
  <g stroke="#45647E" stroke-width="1"><path d="M130 335V363M342 367V393M410 36L480 71M565 409L530 415H455"/></g>
  <g fill="#00B0E4"><circle cx="267" cy="301" r="3"/><circle cx="514" cy="276" r="4"/></g>
 </>}
</svg>
