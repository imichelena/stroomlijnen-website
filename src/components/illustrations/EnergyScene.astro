---
import DeviceDefs from './DeviceDefs.astro';
interface Props { variant: 'hero' | 'wide' | 'compact'; lang: 'nl' | 'en' }
const { variant, lang } = Astro.props;
const p = `energy-${variant}`;
const en = lang === 'en';
const hero = variant === 'hero';
const compact = variant === 'compact';
const ref = (name: string) => `#${p}-${name}`;
const paint = (name: string) => `url(${ref(name)})`;
const labels = en ? ['Solar', 'Building', 'Storage', 'Charging'] : ['Zon', 'Gebouw', 'Opslag', 'Laden'];
const flowLabels = en ? ['Your connection', 'Your EMS', 'Your building', 'Your vehicles'] : ['Uw aansluiting', 'Uw EMS', 'Uw gebouw', 'Uw voertuigen'];
const title = hero ? (en ? 'Your site as one energy system' : 'Uw locatie als één energiesysteem') : (en ? 'Sharing power across your site' : 'Stroom verdelen op uw locatie');
const desc = hero ? (en ? 'A business building with solar panels, battery storage and chargers, connected through one EMS.' : 'Een bedrijfsgebouw met zonnepanelen, batterijopslag en laders, verbonden via één EMS.') : (en ? 'A grid connection supplies local power management. It adjusts charging to building demand, within the available capacity.' : 'Een aansluiting levert stroom aan de lokale verdeling. Die stemt het laden af op wat het gebouw gebruikt, binnen de beschikbare ruimte.');
const traces = hero ? ['M126 351L232 404Q241 408 250 403L302 377', 'M310 293V318Q310 327 320 332L359 351Q370 357 360 363L331 378', 'M349 402L403 429Q413 434 423 429L475 403', 'M414 430L441 444Q450 448 459 443L518 414'] : compact ? ['M180 132V143M180 180V216', 'M180 279V292M180 325Q180 332 166 332H97Q83 332 83 347V393', 'M180 279V292M180 325Q180 332 194 332H269Q283 332 283 347V441'] : ['M235 222H415', 'M550 222H627Q654 222 654 195V129Q654 113 672 113H763', 'M550 222H627Q654 222 654 249V317Q654 333 672 333H779'];
---
<svg class:list={['energy-art', hero ? 'hero-scene' : `flow-${variant}`]} viewBox={hero ? '0 0 600 560' : compact ? '0 0 360 570' : '0 0 1000 440'} role="img" aria-labelledby={`${p}-title ${p}-desc`}>
 <title id={`${p}-title`}>{title}</title><desc id={`${p}-desc`}>{desc}</desc>
 <DeviceDefs prefix={p}/>
 {hero ? <>
  <rect width="600" height="560" rx="10" fill="#F2F5F8"/>
  <ellipse cx="350" cy="276" rx="240" ry="210" fill="#E7EFF4"/>
  <circle cx="350" cy="240" r="170" fill="none" stroke="#D5E2EB" stroke-width="1"/>
  <circle cx="350" cy="240" r="215" fill="none" stroke="#DCE6EE" stroke-width="1" stroke-dasharray="2 7"/>
  <path d="M34 316L277 194L573 342V361L329 483L34 335Z" fill="#C3D2DE"/>
  <path d="M34 316L277 194L573 342L329 464Z" fill="#E0E9F0"/>
  <path d="M34 316L329 464L573 342" fill="none" stroke="#fff" stroke-width="1.5"/>
  <g fill="none" stroke="#C7D7E3" stroke-width=".8"><path d="M80 293L375 441M131 268L426 416M182 242L477 390M233 217L528 365M85 341L329 219M137 367L381 245M189 393L433 271M241 419L485 297M293 445L537 323"/></g>
  <path d="M380 419L435 446L555 386M394 411L449 438M433 391L488 418M472 371L527 398" fill="none" stroke="#F8FBFD" stroke-width="2"/>
 </> : <>
  <rect x="1" y="1" width={compact ? 358 : 998} height={compact ? 568 : 438} rx="16" fill="#0C1C30" stroke="#253C53" stroke-width="1"/>
  <rect width={compact ? 360 : 1000} height={compact ? 570 : 440} fill={paint('dots')}/>
  <ellipse cx={compact ? 180 : 487} cy={compact ? 255 : 219} rx={compact ? 150 : 265} ry="160" fill={paint('halo')} opacity=".45"/>
 </>}
 <!-- Traces sit under the devices, so connections terminate at real ports. -->
 <g fill="none" stroke-linecap="round" stroke-linejoin="round">
  {traces.map(d => <path d={d} stroke={hero ? '#AFCDDB' : '#28465F'} stroke-width="2"/>)}
  {traces.map((d, i) => <g class:list={['current-trace', hero && i < 2 && 'solar-current']} style={`--trace-delay:${i * -.8}s`}>
   <path d={d} stroke={hero && i < 2 ? '#84BD00' : '#00B0E4'} stroke-width="2" filter={paint('glow')} opacity=".85"/>
   <path d={d} stroke={hero && i < 2 ? '#84BD00' : paint('current')} stroke-width="2"/>
  </g>)}
 </g>
 {hero ? <>
  <use href={ref('building')} transform="translate(143 59) scale(1.28)"/>
  <use href={ref('battery')} transform="translate(61 252) scale(.88)"/>
  <use href={ref('battery')} transform="translate(109 276) scale(.88)"/>
  <use href={ref('charger')} transform="translate(447 292) scale(.9)"/>
  <use href={ref('charger')} transform="translate(492 314) scale(.9)"/>
  <use href={ref('van')} transform="translate(182 375) scale(.78)"/>
  <use href={ref('hub')} transform="translate(267 349) scale(.86)"/>
  <g fill="#84BD00"><path d="M59 249L86 235L121 252L94 266Z"/><path d="M493 274L515 263L542 276L520 287Z"/></g>
  <g fill="#598B20"><ellipse cx="88" cy="239" rx="18" ry="12"/><ellipse cx="518" cy="266" rx="15" ry="10"/></g>
  <g fill="#94BE53"><ellipse cx="84" cy="234" rx="14" ry="10"/><ellipse cx="515" cy="262" rx="12" ry="8"/></g>
  <g class="scene-leaders" fill="none" stroke="#7892A7" stroke-width="1"><path d="M302 42V61L320 79"/><path d="M493 201H519V229"/><path d="M61 355L42 365V401"/><path d="M514 426V474H475"/></g>
  <g class="scene-labels" fill="#39566E"><text x="302" y="31" text-anchor="middle">{labels[0]}</text><text x="520" y="246" text-anchor="middle">{labels[1]}</text><text x="42" y="419">{labels[2]}</text><text x="475" y="494" text-anchor="middle">{labels[3]}</text></g>
  <g fill="#00B0E4"><circle cx="320" cy="79" r="2.5"/><circle cx="493" cy="201" r="2.5"/><circle cx="61" cy="355" r="2.5"/><circle cx="514" cy="426" r="2.5"/></g>
  <path d="M40 519H80" stroke="#00B0E4" stroke-width="2"/><path d="M88 519H108" stroke="#84BD00" stroke-width="2"/>
 </> : compact ? <>
  <use href={ref('transformer')} transform="translate(132 17) scale(.85)"/>
  <use href={ref('hub')} transform="translate(117 212) scale(.9)"/>
  <use href={ref('building')} transform="translate(23 365) scale(.48)"/>
  <use href={ref('charger')} transform="translate(290 375) scale(.66)"/>
  <use href={ref('van')} transform="translate(211 416) scale(.64)"/>
  <g class="scene-labels flow-device-labels" text-anchor="middle" fill="#B8C7D6"><text x="180" y="165">{flowLabels[0]}</text><text x="180" y="315">{flowLabels[1]}</text><text x="85" y="521">{flowLabels[2]}</text><text x="275" y="521">{flowLabels[3]}</text></g>
  <g stroke="#45647E" stroke-width="1"><path d="M85 489V504M275 494V504"/></g>
 </> : <>
  <use href={ref('transformer')} transform="translate(114 121) scale(1.05)"/>
  <use href={ref('hub')} transform="translate(410 167) scale(1.05)"/>
  <use href={ref('building')} transform="translate(759 29) scale(.67)"/>
  <use href={ref('charger')} transform="translate(903 245) scale(.82)"/>
  <use href={ref('van')} transform="translate(776 280) scale(.85)"/>
  <g class="scene-labels flow-device-labels" text-anchor="middle" fill="#B8C7D6"><text x="170" y="315">{flowLabels[0]}</text><text x="485" y="315">{flowLabels[1]}</text><text x="847" y="226">{flowLabels[2]}</text><text x="850" y="410">{flowLabels[3]}</text></g>
  <g stroke="#45647E" stroke-width="1"><path d="M170 280V297M485 280V297M847 196V210M850 379V394"/></g>
  <g fill="#00B0E4"><circle cx="296" cy="222" r="3"/><circle cx="654" cy="222" r="4"/></g>
 </>}
</svg>
