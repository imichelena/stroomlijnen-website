---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stroomlijnen — Laadinfrastructuur voor theaters en transport" activeNav="/">
<style>
/* Hero */
.hero{background:linear-gradient(135deg,#0a1628,#0d1e38 60%,#091422);padding:7rem 0 5rem;position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;top:-50%;right:-20%;width:600px;height:600px;background:radial-gradient(circle,rgba(0,176,228,.08) 0%,transparent 70%);pointer-events:none}
.hero-content{max-width:800px;margin-bottom:2.5rem}
.hero h1{font-size:clamp(2rem,4vw,3rem);color:var(--white);margin-bottom:.75rem}
.hero-sub{font-size:1.1rem;color:var(--text);max-width:620px;line-height:1.75;margin-bottom:1.5rem}
.hero-ctas{display:flex;gap:.85rem;flex-wrap:wrap}
.hero-ctas .btn{font-size:.9rem;padding:.7rem 1.5rem}

/* Service pillars — wat levert Stroomlijnen */
.pillars{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;margin-top:1.5rem}
.pillar{background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.12);border-radius:8px;padding:1.25rem 1.5rem;display:flex;gap:.85rem;align-items:flex-start}
.pillar-icon{width:1.75rem;height:1.75rem;flex-shrink:0;margin-top:.05rem}
.pillar-icon svg{width:100%;height:100%}
.pillar h4{color:var(--white);font-size:.95rem;margin-bottom:.2rem}
.pillar p{color:var(--text);font-size:.82rem;line-height:1.55;margin:0}

/* Product cards */
.products-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.25rem;margin-bottom:2rem}
.product-card{background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.15);border-radius:10px;padding:1.5rem;display:flex;flex-direction:column;transition:border-color .2s}
.product-card:hover{border-color:rgba(0,176,228,.35)}
.product-card.featured{border-color:var(--cyan)}
.product-badge{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--cyan);margin-bottom:.4rem}
.product-card h3{color:var(--white);font-size:1rem;margin-bottom:.75rem}
.product-card .price{font-size:1.3rem;font-weight:700;color:var(--white);margin-bottom:.5rem}
.product-card .price small{font-size:.8rem;font-weight:400;color:var(--gray)}
.spec-sm{display:flex;flex-wrap:wrap;gap:.35rem 1rem;font-size:.82rem;color:var(--text);margin-bottom:.75rem}
.spec-sm span{white-space:nowrap}
.product-card .card-link{display:inline-block;margin-top:.75rem;color:var(--cyan);font-size:.85rem;font-weight:600;text-decoration:none;transition:opacity .2s}
.product-card .card-link:hover{opacity:.75}

/* Vertical integration — 7 vs 1 */
.integration-block{background:rgba(0,176,228,.04);border:1px solid rgba(0,176,228,.15);border-radius:10px;padding:2rem;margin-top:1.5rem}
.integration-row{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start}
.integration-many{display:flex;flex-direction:column;gap:.4rem}
.integration-many span{display:flex;align-items:center;gap:.5rem;color:var(--text);font-size:.88rem;padding:.25rem .5rem;border-radius:4px;background:rgba(255,255,255,.03)}
.integration-many .sep{color:var(--cyan);font-weight:700;font-size:1.2rem}
.integration-one{text-align:center;padding:1.5rem;background:rgba(0,176,228,.08);border-radius:8px;border:2px solid var(--cyan)}
.integration-one h3{color:var(--cyan);font-size:1.3rem;margin-bottom:.3rem}
.integration-one p{color:var(--text);font-size:.88rem;margin:0}

/* Benefits */
.cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2rem}
.card{background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.15);border-radius:10px;padding:2rem;transition:border-color .2s;display:flex;flex-direction:column}
.card:hover{border-color:rgba(0,176,228,.35)}
.card-icon{margin-bottom:1rem;flex-shrink:0;width:2rem;height:2rem}
.card-icon svg{width:100%;height:100%}
.card h3{font-size:1.15rem;margin-bottom:.6rem;color:var(--white)}
.card p{color:var(--text);font-size:.92rem;line-height:1.7;flex:1}
.card-link{display:inline-block;margin-top:1rem;color:var(--cyan);font-size:.85rem;font-weight:600;text-decoration:none;transition:opacity .2s}
.card-link:hover{opacity:.75}

/* How it works — 3 steps */
.steps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;margin-top:2rem}
.step-card{background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.12);border-radius:10px;padding:1.75rem;text-align:center}
.step-num{background:var(--cyan);color:var(--navy);width:2.5rem;height:2.5rem;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1rem;margin:0 auto .75rem}
.step-card h3{color:var(--white);font-size:1rem;margin-bottom:.5rem}
.step-card p{color:var(--text);font-size:.85rem;line-height:1.6;margin:0}

/* Stats */
.stats-row{display:flex;gap:2rem;flex-wrap:wrap;justify-content:center;margin-top:1.5rem}
.stat{text-align:center;border-left:3px solid var(--cyan);padding-left:1.25rem;min-width:160px}
.stat-num{display:block;font-size:1.8rem;font-weight:700;color:var(--cyan)}
.stat-label{font-size:.8rem;color:var(--text);line-height:1.4}

/* Urgency */
.urgency-banner{background:linear-gradient(135deg,#071220,#0a1a2e);border-top:1px solid rgba(0,176,228,.1);border-bottom:1px solid rgba(0,176,228,.1)}
.banner-inner{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
.banner-text h2{font-size:1.6rem;color:var(--white);margin-bottom:1rem;line-height:1.3}
.banner-text p{color:var(--text);line-height:1.75;font-size:.95rem}
.banner-quote blockquote{border-left:3px solid var(--green);padding:1.25rem 1.5rem;background:rgba(124,184,47,.06);border-radius:0 8px 8px 0;color:var(--text);font-style:italic;font-size:1.05rem;line-height:1.7;margin:0}

/* CTA */
.cta-section{background:var(--navy-light)}
.cta-inner{text-align:center}
.cta-inner h2{font-size:2rem;margin-bottom:1rem}
.cta-inner p{color:var(--text);margin-bottom:2rem;max-width:520px;margin-left:auto;margin-right:auto;line-height:1.7}

@media(max-width:768px){
  .banner-inner{grid-template-columns:1fr}
  .integration-row{grid-template-columns:1fr}
}
</style>

  <!-- Hero — propositie eerst, producten daarna -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Laadinfrastructuur voor de culturele tour</h1>
        <p class="hero-sub">Van hardware tot laadsessie, van 24/7 monitoring tot energierapportage. Stroomlijnen regelt alles in een compleet pakket — voor theaters én tourende gezelschappen.</p>
        <div class="hero-ctas">
          <a href="/theaters" class="btn btn-primary">Voor theaters →</a>
          <a href="/transport" class="btn btn-outline">Voor gezelschappen →</a>
        </div>
      </div>

      <!-- Vier pijlers: wat Stroomlijnen levert -->
      <div class="pillars">
        <div class="pillar">
          <div class="pillar-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div>
          <div><h4>Hardware</h4><p>Directe import, eigen voorraad in NL. Modulaire 30—180 kW DC-laders met 2 jaar garantie.</p></div>
        </div>
        <div class="pillar">
          <div class="pillar-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
          <div><h4>Platform</h4><p>Eigen beveiligd OCPP 2.0.1 platform. Portal met alle laadsessies, afrekeningen, CO₂-rapportage, ERE-certificaten en incidenten. Zelf uw commerciële tarief instellen.</p></div>
        </div>
        <div class="pillar">
          <div class="pillar-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
          <div><h4>Service</h4><p>24/7 monitoring, remote diagnose, respons binnen 4 uur. Mobiele backup-lader bij uitval.</p></div>
        </div>
        <div class="pillar">
          <div class="pillar-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#84BD00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M14.5 9a3.5 3.5 0 1 0 0 6"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="8" y1="13" x2="14" y2="13"/></svg></div>
          <div><h4>ERE & Cultuurfonds</h4><p>De volledige ERE-opbrengst gaat naar het Cultuurfonds, ten behoeve van projecten en makers op het gebied van muziek en theater.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Producten -->
  <section>
    <div class="container">
      <p style="color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">Producten</p>
      <h2 style="color:var(--white);font-size:1.8rem;margin-bottom:.5rem">Laders voor elk gebruik</h2>
      <p style="color:var(--text);font-size:.9rem;max-width:640px;line-height:1.7;margin-bottom:1.5rem">Stroomlijnen importeert rechtstreeks uit de fabriek — industriële hardware, geen tussenhandel. Alle modellen zijn OCPP 2.0.1, MID-gecertificeerd en worden 24/7 gemonitord.</p>

      <!-- Meta-bar -->
      <div style="display:flex;gap:2rem;flex-wrap:wrap;padding:1rem 1.5rem;background:rgba(0,176,228,.04);border:1px solid rgba(0,176,228,.12);border-radius:8px;margin-bottom:2rem">
        <div style="display:flex;align-items:center;gap:.5rem;color:var(--text);font-size:.85rem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <strong style="color:var(--cyan)">2—4 weken</strong> levertijd uit voorraad NL
        </div>
        <div style="display:flex;align-items:center;gap:.5rem;color:var(--text);font-size:.85rem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#84BD00" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <strong style="color:var(--cyan)">2 jaar</strong> fabrieksgarantie
        </div>
        <div style="display:flex;align-items:center;gap:.5rem;color:var(--text);font-size:.85rem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          <strong style="color:var(--cyan)">Onderdelen</strong> op voorraad in Amsterdam
        </div>
        <div style="display:flex;align-items:center;gap:.5rem;color:var(--text);font-size:.85rem">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#84BD00" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <strong style="color:var(--cyan)">Modulair</strong> — hot-swappable power modules
        </div>
      </div>

      <!-- Product cards met specs -->
      <div class="products-row">
        <div class="product-card">
          <div class="product-badge">AC lader</div>
          <img src="/images/charger-30kw.jpg" alt="22kW AC lader" style="width:100%;height:140px;border-radius:8px;margin-bottom:1rem;object-fit:contain;background:#fff">
          <table style="width:100%;border-collapse:collapse;margin-bottom:.75rem;font-size:.82rem">
            <tr><td style="color:var(--gray);width:40%;padding:.15rem 0">Vermogen</td><td style="color:var(--text);padding:.15rem 0">22 kW AC (3-fase)</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Aansluiting</td><td style="color:var(--text);padding:.15rem 0">Type 2 socket</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Connectiviteit</td><td style="color:var(--text);padding:.15rem 0">4G + WiFi + Ethernet</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Protocol</td><td style="color:var(--text);padding:.15rem 0">OCPP 2.0.1</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Authenticatie</td><td style="color:var(--text);padding:.15rem 0">RFID / QR-code</td></tr>
          </table>
          <div style="display:flex;gap:.3rem;flex-wrap:wrap;margin-top:auto">
            <span style="font-size:.7rem;padding:.2rem .5rem;border-radius:4px;background:rgba(0,176,228,.12);color:var(--cyan);border:1px solid rgba(0,176,228,.2)">Wand/paal</span>
            <span style="font-size:.7rem;padding:.2rem .5rem;border-radius:4px;background:rgba(0,176,228,.12);color:var(--cyan);border:1px solid rgba(0,176,228,.2)">Semi-publiek</span>
          </div>
          <div class="price">€2.499 <small>excl. btw</small></div>
        </div>
        <div class="product-card">
          <div class="product-badge">Mobiele DC lader</div>
          <img src="/images/charger-22kw.jpg" alt="30kW DC mobiele lader" style="width:100%;height:140px;border-radius:8px;margin-bottom:1rem;object-fit:contain;background:#fff">
          <table style="width:100%;border-collapse:collapse;margin-bottom:.75rem;font-size:.82rem">
            <tr><td style="color:var(--gray);width:40%;padding:.15rem 0">Vermogen</td><td style="color:var(--text);padding:.15rem 0">30 kW DC</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Connectiviteit</td><td style="color:var(--text);padding:.15rem 0">4G + WiFi</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Protocol</td><td style="color:var(--text);padding:.15rem 0">OCPP 2.0.1</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Certificering</td><td style="color:var(--text);padding:.15rem 0">MID</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Installatie</td><td style="color:var(--text);padding:.15rem 0">Plug-and-play</td></tr>
          </table>
          <div style="display:flex;gap:.3rem;flex-wrap:wrap;margin-top:auto">
            <span style="font-size:.7rem;padding:.2rem .5rem;border-radius:4px;background:rgba(0,176,228,.12);color:var(--cyan);border:1px solid rgba(0,176,228,.2)">Mobiel</span>
            <span style="font-size:.7rem;padding:.2rem .5rem;border-radius:4px;background:rgba(0,176,228,.12);color:var(--cyan);border:1px solid rgba(0,176,228,.2)">4G</span>
          </div>
          <div class="price">€8.999 <small>excl. btw</small></div>
        </div>
        <div class="product-card featured">
          <div class="product-badge">★ Meest ingezet — vaste DC snellader</div>
          <img src="/images/charger-120kw.jpg" alt="120 kW DC snellader" style="width:100%;height:140px;border-radius:8px;margin-bottom:1rem;object-fit:cover;background:linear-gradient(145deg,#0d1e38,#152a4a)">
          <table style="width:100%;border-collapse:collapse;margin-bottom:.75rem;font-size:.82rem">
            <tr><td style="color:var(--gray);width:40%;padding:.15rem 0">Vermogen</td><td style="color:var(--text);padding:.15rem 0">120 kW DC</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Ontwerp</td><td style="color:var(--text);padding:.15rem 0">Modulair (hot-swap)</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Protocol</td><td style="color:var(--text);padding:.15rem 0">OCPP 2.0.1</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Certificering</td><td style="color:var(--text);padding:.15rem 0">MID</td></tr>
            <tr><td style="color:var(--gray);padding:.15rem 0">Voertuig</td><td style="color:var(--text);padding:.15rem 0">Vrachtwagen / bus</td></tr>
          </table>
          <div style="display:flex;gap:.3rem;flex-wrap:wrap;margin-top:auto">
            <span style="font-size:.7rem;padding:.2rem .5rem;border-radius:4px;background:rgba(0,176,228,.12);color:var(--cyan);border:1px solid rgba(0,176,228,.2)">Vaste installatie</span>
            <span style="font-size:.7rem;padding:.2rem .5rem;border-radius:4px;background:rgba(0,176,228,.12);color:var(--cyan);border:1px solid rgba(0,176,228,.2)">Zwaar transport</span>
            <span style="font-size:.7rem;padding:.2rem .5rem;border-radius:4px;background:rgba(0,176,228,.12);color:var(--cyan);border:1px solid rgba(0,176,228,.2)">Modulair</span>
          </div>
          <div class="price">€27.000 <small>excl. btw*</small></div>
          <p style="color:rgba(255,255,255,.35);font-size:.72rem;margin-top:.35rem">* Na 25% theaterkorting bij Stroomlijnen CPO/eMSP. Catalogusprijs €36.000.</p>
        </div>
      </div>

      <!-- Standaard op alle modellen -->
      <div style="margin-top:2rem">
        <h3 style="color:var(--white);font-size:1.1rem;margin-bottom:1rem">Standaard op alle modellen</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.85rem">
          <div style="background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.12);border-radius:8px;padding:1rem;text-align:center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" style="margin:0 auto .4rem;display:block"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1" fill="#00B0E4"/></svg>
            <p style="color:var(--white);font-size:.82rem;margin:0">OCPP 2.0.1</p>
          </div>
          <div style="background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.12);border-radius:8px;padding:1rem;text-align:center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" style="margin:0 auto .4rem;display:block"><line x1="12" y1="3" x2="12" y2="21"/><path d="M3 9l9-6 9 6"/><line x1="3" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="21" y2="17"/></svg>
            <p style="color:var(--white);font-size:.82rem;margin:0">MID-gecertificeerd</p>
          </div>
          <div style="background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.12);border-radius:8px;padding:1rem;text-align:center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" style="margin:0 auto .4rem;display:block"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <p style="color:var(--white);font-size:.82rem;margin:0">24/7 monitoring</p>
          </div>
          <div style="background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.12);border-radius:8px;padding:1rem;text-align:center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" style="margin:0 auto .4rem;display:block"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <p style="color:var(--white);font-size:.82rem;margin:0">2 jaar garantie</p>
          </div>
          <div style="background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.12);border-radius:8px;padding:1rem;text-align:center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" style="margin:0 auto .4rem;display:block"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <p style="color:var(--white);font-size:.82rem;margin:0">Hot-swap modules</p>
          </div>
          <div style="background:rgba(255,255,255,.04);border:1px solid rgba(0,176,228,.12);border-radius:8px;padding:1rem;text-align:center">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#00B0E4" stroke-width="2" style="margin:0 auto .4rem;display:block"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <p style="color:var(--white);font-size:.82rem;margin:0">Voorraad in NL</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verticale integratie — 7 partijen vs 1 -->
  <section>
    <div class="container">
      <p style="color:var(--cyan);font-size:.85rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">Eén aanspreekpunt</p>
      <h2 style="color:var(--white);font-size:1.8rem;margin-bottom:.5rem">Normaal heeft u zeven partijen nodig. Stroomlijnen doet het in één pakket.</h2>
      <p style="color:var(--text);font-size:.9rem;max-width:700px;line-height:1.7;margin-bottom:1.5rem">Een laadproject vereist normaal een leverancier, installateur, CPO-platform, laadpasbeheer, ERE-registratie, storingsdienst én CO2-rapportage. Stroomlijnen regelt dit allemaal — één contract, één factuur, één telefoonnummer.</p>
      <div class="integration-block">
        <div class="integration-row">
          <div class="integration-many">
            <span>🔌 Leverancier</span>
            <span>🔧 Installateur</span>
            <span>💻 CPO-platform (SaaS, maandkosten)</span>
            <span>🆔 eMSP / laadpasbeheer</span>
            <span>🌿 ERE-certificaatregistratie</span>
